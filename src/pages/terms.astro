---
import Layout from '../layouts/Layout.astro';

const title = 'Free Terms & Conditions — CGPA Helper';
const description = 'Read the terms of service and conditions for using the CGPA Helper calculators and conversion tools.';
---

<Layout title={title} description={description}>
  <div class="container-page py-16 md:py-24 max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight mb-6">Terms &amp; Conditions</h1>
    
    <div class="prose prose-neutral dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-400 space-y-6 leading-relaxed">
      <p><em>Last updated: June 25, 2026</em></p>
      
      <p>
        Welcome to CGPA Helper. By accessing and using our website, you agree to comply with and be bound by the following terms and conditions of use.
      </p>

      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mt-8 mb-3">1. Use of Calculators</h2>
      <p>
        The calculators and tools on CGPA Helper are provided for informational and educational purposes only. While we make every effort to ensure the accuracy of the grading scales and formulas used, we cannot guarantee that the results will exactly match your university's official records.
      </p>

      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mt-8 mb-3">2. Disclaimer of Liability</h2>
      <p>
        CGPA Helper, its creators, and contributors will not be liable for any academic, financial, or other decisions made based on the calculations from this website. It is the student's responsibility to verify official grade conversions and eligibility criteria with their respective academic departments or registrar's office.
      </p>

      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mt-8 mb-3">3. Intellectual Property</h2>
      <p>
        All site design, text, code, graphics, and interface layouts are property of CGPA Helper. You may not copy, reproduce, modify, or distribute any part of our calculators or website content without prior written permission.
      </p>

      <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mt-8 mb-3">4. Modifications</h2>
      <p>
        We reserve the right to modify, suspend, or discontinue any part of the service (including scales, calculators, or formulas) at any time without notice.
      </p>
    </div>
  </div>
</Layout>
