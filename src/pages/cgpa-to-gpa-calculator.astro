        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <label for="gpa2-scale-select" class="block text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-1.5 uppercase tracking-wide">GPA Scale</label>
