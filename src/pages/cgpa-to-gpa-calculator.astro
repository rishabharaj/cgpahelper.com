---
import Layout from '../layouts/Layout.astro';

const title = 'CGPA to GPA & GPA to CGPA Converter Online';
const description = 'Convert your 10-point scale CGPA to a standard US 4.0 GPA scale or vice-versa using our dual interactive converter with sliders and live formula updates.';
const keywords = 'cgpa to gpa, gpa to cgpa, cgpa to gpa converter, convert cgpa to gpa, 10 point cgpa to 4.0 gpa, universal gpa converter';

const faqs = [
  {
    question: 'How do you convert CGPA to GPA using the linear formula?',
    answer: 'To convert cumulative grade point average (CGPA) to grade point average (GPA) on a different scale, divide your CGPA by its maximum possible value (CGPA Scale) and then multiply by the maximum value of the target scale (GPA Scale). Formula: GPA = (CGPA ÷ CGPA Scale) × GPA Scale.',
  },
  {
    question: 'How do you convert a 4-point GPA back to a 10-point CGPA?',
    answer: 'The reverse linear conversion formula is: CGPA = (GPA ÷ GPA Scale) × CGPA Scale. For example, if you have a 3.30 GPA out of 4.0, your CGPA on a 10-point scale is (3.30 ÷ 4) × 10 = 8.25.',
  },
  {
    question: 'Is a simple linear conversion accepted by WES?',
    answer: 'A simple linear conversion is useful for quick estimates, but official evaluation services like WES (World Education Services) use course-by-course transcript reviews. They evaluate your individual course grades and credit weights rather than applying a single formula to your cumulative score.',
  },
];
---

<Layout title={title} description={description} keywords={keywords} faqs={faqs} canonicalPath="/cgpa-to-gpa-calculator">
  <!-- Backdrop subtle gradient -->
  <div class="absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-indigo-50/40 via-transparent to-transparent dark:from-indigo-950/15 pointer-events-none" aria-hidden="true"></div>

  <div class="container-page pt-6 pb-20 relative">
    <!-- ── Breadcrumb ── -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-1.5 text-sm text-neutral-400 dark:text-neutral-500">
        <li>
          <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">Home</a>
        </li>
        <li aria-hidden="true">
