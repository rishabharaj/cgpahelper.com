          <div>
            <label for="cg2-scale-select" class="block text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-1.5 uppercase tracking-wide">CGPA Scale</label>
            <select
              id="cg2-scale-select"
              class="w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl px-3 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all cursor-pointer"
            >
              <option value="10" selected>10-point</option>
              <option value="9">9-point</option>
