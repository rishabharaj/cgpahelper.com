        <div class="bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl p-5 mt-auto relative">
          <div class="flex justify-between items-start mb-4">
            <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">ESTIMATED CGPA</span>
            <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Formula</span>
          </div>
          <div class="flex justify-between items-end">
            <span id="cg2-result" class="text-4xl sm:text-5xl font-extrabold text-blue-900 dark:text-blue-400 tracking-tight leading-none">8.25</span>
            <span id="cg2-formula-text" class="text-[11px] font-mono font-bold text-rose-600 dark:text-rose-400 text-right max-w-[60%] leading-normal">
              (GPA / GPA_scale) &times; CGPA_scale
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- ── Comprehensive Guide: CGPA to GPA ── -->
    <article class="bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-200 dark:border-neutral-800/65">
      <div class="container-page py-16 md:py-20">
        <div class="max-w-4xl mx-auto">
          
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mt-16 mb-6">
            Understanding CGPA to GPA Conversion
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            Cumulative Grade Point Average (CGPA) and Grade Point Average (GPA) are standard metrics used by universities worldwide to measure a student’s overall academic performance. While the terms are often used interchangeably, CGPA typically refers to cumulative scores on a 10-point scale (standard in India, Singapore, and Europe), whereas GPA commonly refers to scores on a 4.0 scale (popular in the US, Canada, and global institutions).
          </p>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            When applying for higher education abroad, particularly in the United States or Canada, translating your CGPA into a US 4.0 GPA scale is one of the most critical steps in the admission process. 
          </p>

          <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-neutral-800 dark:text-neutral-200 mt-10 mb-4">
            The Linear Formula for Quick Conversion
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            For a simple mapping estimation, universities and student coordinators apply the standard linear ratio conversion:
          </p>
          <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl p-6 mb-6 font-mono text-sm text-neutral-800 dark:text-neutral-200">
            <strong>Formula:</strong> Estimated GPA = (CGPA &divide; CGPA Max Scale) &times; Target GPA Scale
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            For example, if your CGPA is 8.20 out of a 10-point scale, and you wish to find its equivalent on a 4.0 scale:
          </p>
          <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl p-6 mb-6 font-mono text-sm text-neutral-800 dark:text-neutral-200">
            Estimated GPA = (8.20 &divide; 10) &times; 4.0 = 3.28
          </div>

          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mt-16 mb-6">
            CGPA to GPA Reference Table
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            Below is a quick reference table showing standard linear mapping values from a 10-point scale to a standard US 4.0 scale:
          </p>

          <div class="overflow-x-auto mb-8">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-neutral-100 dark:bg-neutral-900">
                  <th class="border border-neutral-200 dark:border-neutral-800 px-4 py-3 text-left font-semibold text-neutral-900 dark:text-neutral-100">10-Point CGPA</th>
                  <th class="border border-neutral-200 dark:border-neutral-800 px-4 py-3 text-left font-semibold text-neutral-900 dark:text-neutral-100">US GPA (4.0 Scale)</th>
                  <th class="border border-neutral-200 dark:border-neutral-800 px-4 py-3 text-left font-semibold text-neutral-900 dark:text-neutral-100">Percentage Equivalent</th>
                </tr>
              </thead>
              <tbody class="text-neutral-600 dark:text-neutral-400">
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">10.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">4.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">100%</td></tr>
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">9.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">3.60</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">90%</td></tr>
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">8.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">3.20</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">80%</td></tr>
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">7.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">2.80</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">70%</td></tr>
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">6.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">2.40</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">60%</td></tr>
                <tr><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">5.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">2.00</td><td class="border border-neutral-200 dark:border-neutral-800 px-4 py-2.5">50%</td></tr>
              </tbody>
            </table>
          </div>

          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mt-16 mb-6">
            Official Evaluation vs. Linear Conversion
          </h2>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            While the linear converter is highly helpful for planning and quick evaluations, credential review agencies like World Education Services (WES) do not calculate GPA using simple ratios. WES uses a course-by-course mapping methodology:
          </p>
          <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
            <li><strong>Subject-Wise Review:</strong> Each letter grade earned in your home country is mapped directly to a US equivalent (A, B, C, D, F).</li>
            <li><strong>GPA Weighting:</strong> Standard point weights (A = 4.0, B = 3.0, C = 2.0) are multiplied by the credit hours of the course.</li>
            <li><strong>Final GPA Recalculation:</strong> The total weighted grade points are divided by the total number of academic credits.</li>
          </ul>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            This means your final WES GPA might be slightly higher or lower than the linear conversion depending on how well you performed in high-credit courses.
          </p>

          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mt-16 mb-6">
            Tips for Managing Your GPA
          </h2>
          <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
            <li><strong>Focus on High-Credit Modules:</strong> Courses carrying 4 or 5 credits impact your cumulative score far more than 1 or 2 credit electives.</li>
            <li><strong>Track Your Academic Trajectory:</strong> Consistently improving your marks across semesters looks positive to graduate admissions panels.</li>
            <li><strong>Leverage Free Tool Sets:</strong> Use our integrated tools to calculate your semester values dynamically at <a href="/sgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">SGPA Calculator</a> or cumulative progress at <a href="/cgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA Calculator</a>.</li>
          </ul>

        </div>
      </div>
    </article>

    <!-- ── Additional SEO Content: CGPA to GPA Deep Dive ── -->
    <article class="mt-16">
      <div class="max-w-3xl mx-auto">

        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
          CGPA to GPA Conversion for Study Abroad Applications
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          If you are applying for MS, MBA, or PhD programs in the United States, Canada, the UK, or Australia, converting your Indian CGPA to the American GPA scale is one of the first steps in your application journey. Most US universities require a 4.0 GPA equivalent on your application, and many admission committees use this number as a preliminary screening criterion. Our <strong>CGPA to GPA converter</strong> gives you an instant linear estimate, which is accepted by a majority of programs for initial applications.
        </p>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Graduate programs in STEM fields typically look for a US GPA equivalent of 3.0 or higher (roughly 7.5 on a 10-point CGPA scale). Competitive MBA programs at top-tier schools often expect 3.5+ (approximately 8.75 CGPA). Use our <a href="/cgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA Calculator</a> to first compute your cumulative CGPA across all semesters, then convert it here using the standard <strong>GPA to CGPA converter</strong> options.
        </p>

        <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
          Country-Specific CGPA to GPA Conversion
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          The <strong>CGPA to GPA formula</strong> varies depending on the grading scale used in your country. Indian universities typically use a 10-point CGPA scale, while Pakistan and Bangladesh often use a 4.0 scale similar to the US system. Some European universities grade on a 5-point or 7-point scale. The key is to identify your institution's maximum CGPA scale before performing the conversion.
        </p>
        <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
          <li><strong>India (10-point to 4.0):</strong> GPA = (CGPA ÷ 10) × 4.0 — e.g., 8.5 CGPA = 3.40 GPA</li>
          <li><strong>Pakistan (4.0 to 4.0):</strong> Direct equivalence — a 3.5 GPA remains 3.5 on the US scale</li>
          <li><strong>Bangladesh (4.0 or 5.0 scale):</strong> GPA = (CGPA ÷ Max Scale) × 4.0</li>
          <li><strong>Germany / Europe (1–5 scale, inverted):</strong> Requires special mapping — 1.0 is highest, 5.0 is lowest</li>
        </ul>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          For more complex multi-scale conversions, try our <a href="/universal-gpa-converter" class="text-indigo-600 dark:text-indigo-400 hover:underline">Universal GPA Converter</a> which supports dozens of international grading scales, making it the perfect <strong>international GPA conversion</strong> assistant.
        </p>

        <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
          How WES Evaluates Your Indian CGPA
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          World Education Services (WES) is the most widely used credential evaluation agency for international students. Unlike a simple linear <strong>10 point CGPA to 4.0 GPA</strong> formula, WES performs a detailed course-by-course transcript analysis. Each individual course grade is mapped to a US letter grade equivalent (A, B, C, D, F) based on your university's grading scheme. These letter grades are then assigned standard US grade points and weighted by credit hours to produce a final WES GPA.
        </p>
        <div class="p-5 my-4 bg-amber-50/50 dark:bg-amber-950/20 rounded-xl border border-amber-100 dark:border-amber-900/30">
          <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">
            ⚠️ <strong>Important:</strong> Official <strong>WES GPA conversion</strong> results can differ significantly from linear conversions. A student with 8.0 CGPA on a 10-point scale might receive a WES GPA anywhere from 2.8 to 3.5, depending on their individual course grade distribution and the credit weighting.
          </p>
        </div>

        <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
          Common Pitfalls in CGPA to GPA Conversion
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Many students make avoidable mistakes when converting their <strong>Indian CGPA to American GPA</strong> for international applications. Here are the most common pitfalls and how to avoid them:
        </p>
        <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
          <li><strong>Using the wrong scale maximum:</strong> Some Indian universities grade on a 4-point scale, not 10-point. Always verify your institution's grading policy before you <strong>convert CGPA to GPA</strong>.</li>
          <li><strong>Confusing SGPA with CGPA:</strong> Your semester GPA (SGPA) is not the same as your cumulative GPA (CGPA). Universities want your cumulative score. Calculate it first using our <a href="/sgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">SGPA Calculator</a>.</li>
          <li><strong>Assuming linear conversion equals WES GPA:</strong> A linear estimate is a helpful approximation, but it is not an official WES evaluation. Do not report a linear conversion as your "WES GPA" on applications.</li>
          <li><strong>Ignoring credit weighting:</strong> Courses with higher credit hours have a larger impact on your cumulative GPA. Two A-grades in 1-credit labs count far less than one B in a 5-credit core course.</li>
        </ul>

        <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
          How to Report Your Converted GPA on Resumes & CVs
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          When listing your grades on a resume or CV for international job markets, it is important to avoid confusing the reader. If you choose to display a converted US GPA, always include the original CGPA alongside it. For instance, you should write: <strong>GPA: 3.60/4.00 (Equivalent to 9.00/10.00 CGPA)</strong>. This format provides full transparency and prevents HR managers from assuming you attended a US institution.
        </p>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Additionally, if your college has a rigorous grading curve where securing high scores is exceptionally difficult, mentioning your rank (e.g., "Top 5% of class") alongside your GPA adds valuable context that admissions panels appreciate.
        </p>

        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          By understanding these nuances, you can present the most accurate and favourable version of your academic record. Use this <strong>CGPA to US GPA</strong> converter for quick estimates, and always cross-reference with official evaluation services for formal applications.
        </p>

      </div>
    </article>

    <!-- ── Frequently Asked Questions ── -->
    <section class="mt-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-5 text-sm font-medium select-none">
                {faq.question}
                <svg class="w-5 h-5 text-neutral-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-5 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed -mt-1">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  // ── DOM Elements Left Card ──
  const cg1Select = document.getElementById('cg1-scale-select') as HTMLSelectElement;
  const gpa1Select = document.getElementById('gpa1-scale-select') as HTMLSelectElement;
  const cg1Input = document.getElementById('cg1-input') as HTMLInputElement;
  const cg1Slider = document.getElementById('cg1-slider') as HTMLInputElement;
  const cg1Result = document.getElementById('cg1-result')!;
  const cg1FormulaText = document.getElementById('cg1-formula-text')!;

  // ── DOM Elements Right Card ──
  const gpa2Select = document.getElementById('gpa2-scale-select') as HTMLSelectElement;
  const cg2Select = document.getElementById('cg2-scale-select') as HTMLSelectElement;
  const gpa2Input = document.getElementById('gpa2-input') as HTMLInputElement;
  const gpa2Slider = document.getElementById('gpa2-slider') as HTMLInputElement;
  const cg2Result = document.getElementById('cg2-result')!;
  const cg2FormulaText = document.getElementById('cg2-formula-text')!;

  // Update validation and calculation
  function calculateLeftCard() {
    const cgScale = parseFloat(cg1Select.value);
    const gpaScale = parseFloat(gpa1Select.value);
    
    // Set max attribute dynamically
    cg1Input.max = String(cgScale);
    cg1Slider.max = String(cgScale);

    let val = parseFloat(cg1Input.value);
    if (isNaN(val)) val = 0;
    if (val > cgScale) {
      val = cgScale;
      cg1Input.value = val.toFixed(2);
    }
    if (val < 0) {
      val = 0;
      cg1Input.value = '0.00';
    }

    const calculated = (val / cgScale) * gpaScale;
    cg1Result.textContent = calculated.toFixed(2);
    cg1Slider.value = String(val);

    // Update Formula Text
    cg1FormulaText.innerHTML = `(${val.toFixed(2)} / ${cgScale}) &times; ${gpaScale}`;
  }

  function calculateRightCard() {
    const gpaScale = parseFloat(gpa2Select.value);
    const cgScale = parseFloat(cg2Select.value);

    // Set max attribute dynamically
    gpa2Input.max = String(gpaScale);
    gpa2Slider.max = String(gpaScale);

    let val = parseFloat(gpa2Input.value);
    if (isNaN(val)) val = 0;
    if (val > gpaScale) {
      val = gpaScale;
      gpa2Input.value = val.toFixed(2);
    }
    if (val < 0) {
      val = 0;
      gpa2Input.value = '0.00';
    }

    const calculated = (val / gpaScale) * cgScale;
    cg2Result.textContent = calculated.toFixed(2);
    gpa2Slider.value = String(val);

    // Update Formula Text
    cg2FormulaText.innerHTML = `(${val.toFixed(2)} / ${gpaScale}) &times; ${cgScale}`;
  }

  // Bind Left Card Events
  cg1Select.addEventListener('change', calculateLeftCard);
  gpa1Select.addEventListener('change', calculateLeftCard);
  
  cg1Input.addEventListener('input', () => {
    calculateLeftCard();
  });
  cg1Slider.addEventListener('input', () => {
    cg1Input.value = parseFloat(cg1Slider.value).toFixed(2);
    calculateLeftCard();
  });

  // Bind Right Card Events
  gpa2Select.addEventListener('change', calculateRightCard);
  cg2Select.addEventListener('change', calculateRightCard);

  gpa2Input.addEventListener('input', () => {
    calculateRightCard();
  });
  gpa2Slider.addEventListener('input', () => {
    gpa2Input.value = parseFloat(gpa2Slider.value).toFixed(2);
    calculateRightCard();
  });

  // Init
  calculateLeftCard();
  calculateRightCard();
</script>
