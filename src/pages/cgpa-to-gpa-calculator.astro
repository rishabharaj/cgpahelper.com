            <span class="bg-neutral-100 dark:bg-neutral-900 text-xs font-bold text-neutral-500 dark:text-neutral-400 px-4 py-3 flex items-center border-r border-neutral-200 dark:border-neutral-800 select-none">
              GPA
            </span>
            <input
              type="number"
              id="gpa2-input"
              value="3.30"
              step="0.01"
              min="0"
              max="4"
              class="w-full bg-transparent px-4 py-3 text-sm font-medium focus:outline-none tabular-nums text-neutral-800 dark:text-neutral-200"
