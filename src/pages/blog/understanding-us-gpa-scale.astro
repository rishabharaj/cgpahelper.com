---
import Layout from '../../layouts/Layout.astro';

const title = 'Understanding the US GPA Scale: How the 4.0 Grading System Works';
const description = 'Demystify the U.S. grading system. Learn the difference between weighted and unweighted GPA, view the standard letter-to-GPA conversion chart, and master the calculation formula.';

