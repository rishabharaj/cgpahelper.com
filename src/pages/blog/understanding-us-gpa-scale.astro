        </a>
        <a
          href="/blog"
          class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider border border-neutral-700 text-neutral-300 hover:text-white hover:border-neutral-600 transition-colors"
        >
          Browse All Guides
        </a>
      </div>
    </div>

  </div>
</Layout>
