---
import Layout from '../../layouts/Layout.astro';

const title = 'Academic Blog & GPA Guides — CGPA Helper';
const description = 'Explore expert academic guides on GPA and CGPA calculations, conversion formulas, school board grading scales, and tips to improve your grades.';

const featuredPost = {
  title: 'CGPA vs SGPA: The Differences, Formulas & Compounding Explained',
  description: 'Confused about the differences between Cumulative GPA (CGPA) and Semester GPA (SGPA)? Read our ultimate guide where we break down the definitions, explain credit weighting, show step-by-step calculations, and offer an interactive compounding simulator to visualize your academic growth.',
  href: '/cgpa-vs-sgpa',
  publishDate: 'June 25, 2026',
  author: 'Dr. Vivek Sharma',
  readTime: '6 min read',
  tag: 'Featured Guide',
  category: 'Academic Core',
  image: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=1200&auto=format&fit=crop'
};

const blogPosts = [
  {
    title: 'Understanding the US GPA Scale: How the 4.0 Grading System Works',
    description: 'Demystify the U.S. grading system. Learn the difference between weighted and unweighted GPA, view the standard letter-to-GPA conversion chart, and master the calculation formula.',
    href: '/blog/understanding-us-gpa-scale',
    publishDate: 'June 26, 2026',
    author: 'Sarah Jenkins',
    readTime: '6 min read',
    category: 'International Systems',
    image: 'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'Guide to International Grading Systems: How to Compare GPA, CGPA & ECTS',
    description: 'Compare global grading scales. A complete reference comparing the U.S. 4.0 Scale, Indian 10-point CGPA, UK Degree Classifications, European ECTS, Canada, and Australia.',
    href: '/blog/guide-to-international-grading-systems',
    publishDate: 'June 26, 2026',
    author: 'Dr. Vivek Sharma',
    readTime: '7 min read',
    category: 'International Systems',
    image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'How to Improve Your CGPA in College: 10 Proven Strategies',
    description: 'Struggling with a low GPA? Discover 10 actionable, credit-weighted tips to boost your CGPA, manage your coursework, and raise your academic standing.',
    href: '/blog/how-to-improve-cgpa',
    publishDate: 'June 25, 2026',
    author: 'Dr. Vivek Sharma',
    readTime: '6 min read',
    category: 'Student Advice',
    image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'CBSE Class 10 CGPA to Percentage: Official 9.5 Formula',
    description: 'Confused about how to convert your CBSE CGPA to percentage? Learn the official board formula, check conversion examples, and understand the 9.5 multiplier.',
    href: '/blog/cbse-cgpa-to-percentage',
    publishDate: 'June 23, 2026',
    author: 'Sarah Jenkins',
    readTime: '5 min read',
    category: 'Board Guides',
    image: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'How to Convert CGPA to Percentage: Standard & Official Formulas',
    description: 'Converting your cumulative grade points to a percentage is essential for university applications and job recruitments. Learn the official formulas approved by CBSE, UGC India, and specific universities like VIT, SRM, Mumbai University, and more.',
    href: '/cgpa-to-percentage',
    publishDate: 'June 18, 2026',
    author: 'Sarah Jenkins',
    readTime: '4 min read',
    category: 'Conversions',
    image: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'Understanding SGPA: How to Calculate Semester GPA with Credit Hours',
    description: 'Learn the exact math behind your Semester Grade Point Average (SGPA). We break down credit points, grade weights, and how to do the step-by-step calculation with practical student transcript examples.',
    href: '/sgpa-calculator',
    publishDate: 'June 12, 2026',
    author: 'Prof. Alok Gupta',
    readTime: '5 min read',
    category: 'Tutorials',
    image: 'https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=600&auto=format&fit=crop'
  },
  {
    title: 'Percentage to CGPA: Reverse Conversion Guide for Indian Universities',
    description: 'Looking to convert your marks percentage back into CGPA or GPA? Discover standard tables, UGC reverse conversion formulas, and use our quick tools to obtain your GPA on 10.0 and 4.0 scales.',
    href: '/percentage-to-cgpa',
    publishDate: 'June 05, 2026',
    author: 'Ryan Miller',
    readTime: '4 min read',
    category: 'Guides',
    image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600&auto=format&fit=crop'
  }
];
---

<Layout title={title} description={description} canonicalPath="/blog">
  <div class="container-page py-12 md:py-16">
    <!-- ── Breadcrumb ── -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-1.5 text-sm text-neutral-400 dark:text-neutral-500">
        <li>
          <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
        </li>
        <li aria-hidden="true">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li>
          <span class="text-neutral-900 dark:text-neutral-100 font-medium">Blog &amp; Guides</span>
        </li>
      </ol>
    </nav>

    <!-- ── Page Header ── -->
    <header class="max-w-3xl mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-100/50 dark:border-indigo-900/30 mb-4">
        📚 Student Learning Hub
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight mb-4 leading-tight">
        Academic <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Blogs &amp; Guides</span>
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-base md:text-lg">
        Unlock grading systems, master conversion formulas, and get the tools you need to optimize your GPA and succeed academically.
      </p>
    </header>

    <!-- ── Featured Post (Main SGPA vs CGPA Guide) ── -->
    <section class="mb-16">
      <div class="group relative bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 grid lg:grid-cols-12 gap-0">
        <!-- Image Area -->
        <div class="lg:col-span-7 h-64 sm:h-80 lg:h-auto min-h-[300px] relative overflow-hidden bg-neutral-100 dark:bg-neutral-800">
          <img
            src={featuredPost.image}
            alt={featuredPost.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent lg:hidden"></div>
          <span class="absolute top-4 left-4 text-xs font-bold uppercase tracking-wider bg-indigo-600 text-white px-3 py-1 rounded-full shadow">
            {featuredPost.tag}
          </span>
        </div>

        <!-- Content Area -->
        <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3">
              <span>{featuredPost.category}</span>
              <span class="w-1 h-1 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
              <span>{featuredPost.readTime}</span>
            </div>
            
            <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-4 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              <a href={featuredPost.href}>
                {featuredPost.title}
              </a>
            </h2>
            
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-6">
              {featuredPost.description}
            </p>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-neutral-800 mt-auto">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-950/50 flex items-center justify-center text-xs font-semibold text-indigo-600 dark:text-indigo-400">
                {featuredPost.author.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <p class="text-xs font-medium text-neutral-800 dark:text-neutral-200">{featuredPost.author}</p>
                <p class="text-[10px] text-neutral-400 dark:text-neutral-500">{featuredPost.publishDate}</p>
              </div>
            </div>
            
            <a
              href={featuredPost.href}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 group/link"
            >
              Read Guide
              <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Blog Grid ── -->
    <section>
      <h3 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 mb-6 flex items-center gap-2 font-mono">
        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
        Latest Publications
      </h3>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post) => (
          <article class="group flex flex-col bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 hover:border-neutral-300 dark:hover:border-neutral-700">
            <!-- Image -->
            <div class="h-48 overflow-hidden bg-neutral-100 dark:bg-neutral-800 relative">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 text-[10px] font-bold uppercase tracking-wider bg-white/90 dark:bg-neutral-950/95 text-neutral-800 dark:text-neutral-200 px-2 py-0.5 rounded border border-neutral-200/50 dark:border-neutral-800/50 backdrop-blur-sm">
                {post.category}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-[10px] font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2">
                  <span>{post.publishDate}</span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>
                
                <h4 class="text-base font-semibold tracking-tight text-neutral-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-2">
                  <a href={post.href}>
                    {post.title}
                  </a>
                </h4>
                
                <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4 line-clamp-3">
                  {post.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-neutral-800 mt-auto">
                <span class="text-xs text-neutral-400 dark:text-neutral-500 font-medium">By {post.author}</span>
                <a
                  href={post.href}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300"
                >
                  Read Article
                  <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
