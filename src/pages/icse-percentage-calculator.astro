---
import Layout from '../layouts/Layout.astro';

const title = 'FREE ICSE Percentage Calculator — CBSE, ICSE & State Boards | CGPAHelper';
const description = 'Calculate your board exam CGPA and convert CGPA to percentage for CBSE, ICSE, State Board, and IGCSE. Official board grading scales with instant CGPA to percentage conversion.';

const faqs = [
  {
    question: 'How is CBSE Class 10 CGPA calculated?',
    answer: 'CBSE CGPA is calculated by taking the average of the Grade Points (GP) earned in the 5 main subjects. Grade Points map to marks out of 100: 91-100 is 10 GP (A1), 81-90 is 9 GP (A2), 71-80 is 8 GP (B1), etc. Formula: CGPA = Sum of GP of 5 subjects ÷ 5.',
  },
  {
    question: 'How do I convert CBSE CGPA to percentage?',
    answer: 'To convert CBSE CGPA to percentage, multiply your CGPA by 9.5. For example, if your CGPA is 8.8, your equivalent percentage is 8.8 × 9.5 = 83.6%. This formula is officially recommended by CBSE and approved by UGC India.',
  },
  {
    question: 'Does ICSE have an official CGPA system?',
    answer: 'No, the Council for the Indian School Certificate Examinations (CISCE) does not issue an official CGPA. Results are mark-based with letter grades (A*–F). However, many Indian colleges convert ICSE marks to an unofficial CGPA by dividing the aggregate percentage by 10 (Percentage ÷ 10) for admission purposes.',
  },
  {
    question: 'How is IGCSE GPA calculated?',
    answer: 'Since IGCSE uses letter grades (A* to G), there is no single official CGPA system. To calculate CGPA, a 10-point scale is commonly used by mapping: A* = 10 GP, A = 9 GP, B = 8 GP, C = 7 GP, D = 6 GP, E = 5 GP, F = 4 GP, G = 3 GP, U = 0 GP. Your CGPA is the average of these points across all subjects.',
  },
  {
    question: 'What is the "Best of 5" rule for board calculations?',
    answer: 'Many admission boards and schools calculate your overall percentage or CGPA using the "Best of 5" rule: English (which is compulsory) plus the next 4 subjects with the highest scores. You can easily remove lower-scoring subjects using our trash icon to calculate your Best of 5 score.',
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/icse-percentage-calculator"
  keywords="cbse cgpa calculator, icse percentage calculator, board cgpa calculator, convert cbse cgpa to percentage, board exam percentage calculator, best of 5 rule"
  faqs={faqs}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Board CGPA Calculator', url: '/icse-percentage-calculator' }
  ]}
>
  <!-- ── Breadcrumb ── -->
  <nav aria-label="Breadcrumb" class="container-page pt-6 pb-2">
    <ol class="flex items-center gap-1.5 text-xs text-neutral-400 dark:text-neutral-500">
      <li>
        <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">Home</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <span class="text-neutral-700 dark:text-neutral-200 font-medium" aria-current="page">Board CGPA Calculator</span>
      </li>
    </ol>
  </nav>

  <!-- ── Page Header ── -->
  <header class="container-page pt-6 pb-10 md:pt-8 md:pb-14">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] mb-4">
      Board CGPA <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>
    </h1>
    <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Convert your school board marks or letter grades into CGPA and percentage. Supports CBSE, ICSE (CISCE), IGCSE, and Indian State Boards.
    </p>
  </header>

  <!-- ── Calculator Section ── -->
  <section class="container-page pb-16">
    <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-sm overflow-hidden">
      <!-- Board Details Banner -->
      <div id="board-banner" class="px-5 py-4 md:px-6 bg-indigo-50/40 dark:bg-indigo-950/20 border-b border-neutral-200 dark:border-neutral-800 text-sm text-indigo-900 dark:text-indigo-300 leading-relaxed">
        <!-- Content will be updated dynamically by JS -->
      </div>

      <!-- Card Header: Board Tabs Segmented Control -->
      <div class="px-4 py-4 sm:px-6 md:px-8 border-b border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-neutral-900">
        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-mono">Select Board</span>
        <!-- Tabs for Boards -->
        <div class="flex w-full sm:w-auto p-1 bg-neutral-100 dark:bg-neutral-800 rounded-xl gap-1 print:hidden">
          <button
            type="button"
            data-board-tab="icse"
            class="board-tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="block sm:inline-block">ICSE</span> <span class="block sm:inline-block text-[8px] sm:text-xs opacity-75">(CISCE)</span>
          </button>
          <button
            type="button"
            data-board-tab="cbse"
            class="board-tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            CBSE
          </button>
          <button
            type="button"
            data-board-tab="state-board"
            class="board-tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="block sm:inline-block">State</span> <span class="block sm:inline-block">Board</span>
          </button>
          <button
            type="button"
            data-board-tab="igcse"
            class="board-tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            IGCSE
          </button>
        </div>

        <!-- Hidden native select for backend compatibility -->
        <select
          id="board-select"
          aria-label="Select board"
          class="sr-only"
        >
          <option value="icse" selected>ICSE (CISCE)</option>
          <option value="cbse">CBSE</option>
          <option value="state-board">State Board</option>
          <option value="igcse">IGCSE</option>
        </select>
      </div>

      <!-- Subjects Table -->
      <div class="px-5 py-5 md:px-6">
        <!-- Table header -->
        <div class="grid grid-cols-[1fr_75px_100px_24px] sm:grid-cols-[1fr_140px_140px_40px] gap-1.5 sm:gap-4 mb-3 pb-2 border-b border-neutral-100 dark:border-neutral-800/60 px-1">
          <span class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Subject</span>
          <span id="score-header" class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Marks</span>
          <span class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Grade / Points</span>
          <span class="sr-only">Remove</span>
        </div>

        <!-- Rows container -->
        <div id="subject-rows" class="space-y-1.5" role="list" aria-label="Subject list">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Add Subject & Action Buttons -->
        <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
          <button
            id="add-subject-btn"
            type="button"
            class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors cursor-pointer"
          >
            <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add Subject
          </button>

          <button
            id="calculate-btn"
            type="button"
            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white rounded-lg text-sm font-semibold transition-colors cursor-pointer shadow-sm"
          >
            Calculate CGPA
          </button>
        </div>
      </div>

      <!-- Result section -->
      <div id="result-section" class="border-t border-neutral-200 dark:border-neutral-800 px-5 py-8 md:px-6 flex flex-col sm:flex-row items-center gap-6 sm:gap-10" style="display:none;">
        <!-- Linear Progress Bar -->
        <div class="w-full sm:w-48 shrink-0 space-y-2">
          <div class="flex justify-between text-xs font-semibold text-neutral-500 dark:text-neutral-400 font-mono">
            <span>0%</span>
            <span id="gauge-percent-text">0%</span>
          </div>
          <div class="w-full bg-neutral-100 dark:bg-neutral-800 h-3 rounded-full overflow-hidden">
            <div
              id="gauge-ring"
              class="h-full rounded-full transition-all duration-500 ease-out"
