  <!-- ── Board Quick Navigation Footer (In-Page Navigation) ── -->
  <section class="container-page pb-16">
    <div class="bg-neutral-50 dark:bg-neutral-900/40 border border-neutral-200 dark:border-neutral-800/80 rounded-xl p-6">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-mono mb-4">Board Calculator Quick-Links</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <button
          type="button"
          data-board-link="cbse"
          class="flex flex-col p-4 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-left hover:border-indigo-500 dark:hover:border-indigo-400 hover:shadow-sm transition-all cursor-pointer group"
        >
          <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">CBSE CGPA</span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Multiplies by 9.5 factor</span>
        </button>

        <button
          type="button"
          data-board-link="icse"
          class="flex flex-col p-4 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-left hover:border-indigo-500 dark:hover:border-indigo-400 hover:shadow-sm transition-all cursor-pointer group"
        >
          <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">ICSE Board GPA</span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Percentage / 10 system</span>
        </button>

        <button
          type="button"
          data-board-link="state-board"
          class="flex flex-col p-4 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-left hover:border-indigo-500 dark:hover:border-indigo-400 hover:shadow-sm transition-all cursor-pointer group"
        >
          <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">State Board CGPA</span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">Aggregate / 10 reference</span>
        </button>

        <button
          type="button"
          data-board-link="igcse"
          class="flex flex-col p-4 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-left hover:border-indigo-500 dark:hover:border-indigo-400 hover:shadow-sm transition-all cursor-pointer group"
        >
          <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">IGCSE CGPA</span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">A* to G Letter Grade mapping</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ── Comprehensive Academic Guide ── -->
  <article class="container-page pb-16">
    <div class="max-w-3xl">

      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
        How to Calculate CBSE Board CGPA
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        The Central Board of Secondary Education (CBSE) uses a grade-point based system for Class 10 results. Each subject score out of 100 is mapped to a Grade Point (GP) on a scale of 1 to 10. Your overall CBSE CGPA is the simple average of the Grade Points obtained in your five main subjects. This <strong>CBSE CGPA calculator</strong> automates the entire process — just enter your marks and the <strong>board exam CGPA</strong> is computed instantly.
      </p>
      <div class="p-5 my-4 bg-indigo-50/50 dark:bg-indigo-950/20 rounded-xl border border-indigo-100 dark:border-indigo-900/30 text-center font-mono text-base sm:text-lg text-indigo-700 dark:text-indigo-400">
        CGPA = (GP₁ + GP₂ + GP₃ + GP₄ + GP₅) ÷ 5
      </div>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        For example, if a student scores 95, 88, 76, 82, and 91 in five subjects, the corresponding Grade Points are 10, 9, 8, 9, and 10. The CBSE CGPA equals (10 + 9 + 8 + 9 + 10) ÷ 5 = <strong>9.20</strong>. You can use our <a href="/cgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA Calculator</a> for university-level semester CGPA as well. This <strong>board CGPA calculator</strong> makes it extremely easy to visualize your aggregate grades without manual conversions.
      </p>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        CBSE vs ICSE Grading Systems
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        While CBSE assigns official Grade Points and a cumulative CGPA on the Class 10 marksheet, the ICSE board (administered by CISCE) does not issue an official CGPA. ICSE results are entirely mark-based, with letter grades ranging from A* to F. Many Indian colleges convert ICSE aggregate percentages to an unofficial CGPA by dividing by 10. The <strong>ICSE CGPA calculator</strong> on this page handles both systems — select CBSE for official GP-based calculation, or ICSE for the percentage-to-CGPA reference conversion.
      </p>
      <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
        <li><strong>CBSE:</strong> Official CGPA on a 10-point scale with defined GP ranges (91–100 = A1 = 10 GP, etc.)</li>
        <li><strong>ICSE:</strong> No official CGPA — mark-based with letter grades; colleges use Percentage ÷ 10 as an unofficial reference</li>
        <li><strong>State Boards:</strong> Generally mark-based; unofficial CGPA = Average Percentage ÷ 10</li>
        <li><strong>IGCSE:</strong> Letter-grade system (A* to G) mapped to a 10-point scale for credit equivalency</li>
      </ul>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        State Board Grading and CGPA Equivalents
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Apart from the central boards (CBSE and ICSE), various state education boards (such as AP Board, Telangana Board, Tamil Nadu State Board, and Maharashtra State Board) have historically used mark-based sheets or individual grading systems. For instance, Andhra Pradesh (AP) and Telangana Class 10 results frequently use a 10-point GPA scale with grades like A1, A2, B1, B2, etc. Unlike the CBSE 9.5 multiplier, some state boards use a simple multiplier of 10 to calculate equivalent marks percentage, or they publish specific percentage mapping ranges. Our calculator includes presets for State Board CGPA references to ensure students can easily convert state-level board exam GPAs back to standard percentages.
      </p>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        CBSE CGPA to Percentage: The Official 9.5 Multiplier
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Converting <strong>CBSE CGPA to percentage</strong> is straightforward — multiply your CGPA by 9.5. This conversion factor is officially recommended by CBSE and recognized by the University Grants Commission (UGC). For a student with a CGPA of 8.8, the equivalent percentage is 8.8 × 9.5 = <strong>83.6%</strong>. Use our dedicated <a href="/cgpa-calculator?tab=percentage&mode=to-percentage" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA to Percentage converter</a> for more grading scale options.
      </p>
      <div class="p-5 my-4 bg-indigo-50/50 dark:bg-indigo-950/20 rounded-xl border border-indigo-100 dark:border-indigo-900/30 text-center font-mono text-base sm:text-lg text-indigo-700 dark:text-indigo-400">
        Percentage = CGPA × 9.5
      </div>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        Understanding the Best of 5 Rule
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        The "Best of 5" rule is widely used by schools and admission boards across India. Under this rule, your overall CGPA or percentage is calculated using English (which is compulsory) plus your four highest-scoring subjects. This ensures that one lower-performing elective does not drag down your overall <strong>class 10 CGPA calculator</strong> result. In our calculator, you can remove lower-scoring subjects using the trash icon to simulate your <strong>best of 5 CGPA</strong>.
      </p>
      <div class="p-5 my-4 bg-amber-50/50 dark:bg-amber-950/20 rounded-xl border border-amber-100 dark:border-amber-900/30">
        <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">
          💡 <strong>Tip:</strong> Many DU and state university cutoffs are based on the Best of 5 percentage. Make sure you calculate your <strong>board exam percentage calculator</strong> score using this rule before comparing against cutoff lists.
        </p>
      </div>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        IGCSE Grading Scale: How IGCSE Grades Convert to CGPA and Percentage
      </h3>
      <p class="text-neutral-600 dark:text-neutral-450 leading-relaxed mb-4">
        The International General Certificate of Secondary Education (<strong>IGCSE</strong>) uses a letter-grading system (traditionally A* to G, or increasingly the 9-to-1 scale in schools following Cambridge or Edexcel guidelines). Because the IGCSE does not provide a cumulative <strong>board exam percentage calculator</strong> score or GPA on the official transcript, students applying to Indian, US, or Canadian universities often need to map their grades to a numeric equivalency.
      </p>
      <p class="text-neutral-600 dark:text-neutral-450 leading-relaxed mb-4">
        In our calculator, we use the standard international credit mapping system where IGCSE letter grades are converted to a <strong>10-point GPA scale</strong>. Under this mapping:
      </p>
      <div class="overflow-x-auto my-4 border border-neutral-200 dark:border-neutral-800 rounded-xl">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 font-semibold text-neutral-700 dark:text-neutral-300">
              <th class="py-2.5 px-4">IGCSE Grade</th>
              <th class="py-2.5 px-4">Equivalent Grade Points (GP)</th>
              <th class="py-2.5 px-4">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800/60 text-neutral-600 dark:text-neutral-400">
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">A*</td>
              <td class="py-2 px-4">10.00</td>
              <td class="py-2 px-4">Outstanding</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">A</td>
              <td class="py-2 px-4">9.00</td>
              <td class="py-2 px-4">Excellent</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">B</td>
              <td class="py-2 px-4">8.00</td>
              <td class="py-2 px-4">Very Good</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">C</td>
              <td class="py-2 px-4">7.00</td>
              <td class="py-2 px-4">Good / Pass</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">D</td>
              <td class="py-2 px-4">6.00</td>
              <td class="py-2 px-4">Satisfactory</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">E</td>
              <td class="py-2 px-4">5.00</td>
              <td class="py-2 px-4">Acceptable</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">F / G</td>
              <td class="py-2 px-4">4.00 / 3.00</td>
              <td class="py-2 px-4">Minimum Pass</td>
            </tr>
            <tr>
              <td class="py-2 px-4 font-mono font-semibold text-indigo-600 dark:text-indigo-400">U</td>
              <td class="py-2 px-4">0.00</td>
              <td class="py-2 px-4">Ungraded / Fail</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-neutral-600 dark:text-neutral-450 leading-relaxed mb-4">
        To calculate your <strong>IGCSE GPA</strong>, take the average of these equivalent grade points across all your selected subjects. If you need to translate your overall IGCSE performance to an approximate percentage, you can map the resulting GPA back using a standard linear multiplier (e.g. GPA × 9.5) or refer to specific university-wise credential evaluation guidelines (like WES).
      </p>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        Board CGPA for College Admissions
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Your board CGPA plays a critical role during college admissions, especially for undergraduate programs at central universities. CBSE and ICSE board percentages (derived from CGPA) are directly compared against admission cutoffs. Some universities accept CGPA directly, while others require the converted percentage. Understanding the relationship between your board exam CGPA and the cutoff format is essential for successful applications. Check the difference between cumulative and semester averages with our <a href="/cgpa-vs-sgpa" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA vs SGPA comparison guide</a>.
      </p>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Whether you are a CBSE student looking to convert your CGPA to percentage for DU admissions, or an ICSE student needing an unofficial board CGPA for comparison, this <strong>board exam percentage calculator</strong> gives you accurate, instant results. Select your board from the dropdown above and get started.
      </p>

    </div>
  </article>

  <!-- ── Frequently Asked Questions ── -->
  <section class="container-page pb-16">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-sm font-medium select-none">
              {faq.question}
              <svg class="w-5 h-5 text-neutral-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed -mt-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { jsPDF } from 'jspdf';
  // ── Types & Structures ──
  interface BoardConfig {
    name: string;
    description: string;
    scoreType: 'marks' | 'grades';
    defaultSubjects: Array<{ name: string; value: number | string }>;
    calculate: (subjects: Array<{ name: string; score: number | string }>) => {
      cgpa: number;
      percentage: number;
      label: string;
      labelClass: string;
      note: string;
    };
  }

  // ── Board Rules Configuration ──
  const boardConfigs: Record<string, BoardConfig> = {
    cbse: {
      name: 'CBSE Class 10 (CGPA Scale)',
      description: 'CBSE Class 10 uses Grade Points (GP) for calculation. Your overall CGPA is the average of Grade Points obtained in the 5 main subjects. The percentage can be calculated by multiplying the CGPA by 9.5 (Percentage = CGPA × 9.5).',
      scoreType: 'marks',
      defaultSubjects: [
        { name: 'English', value: 85 },
        { name: 'Mathematics', value: 90 },
        { name: 'Science', value: 82 },
        { name: 'Social Science', value: 78 },
        { name: 'Second Language', value: 80 }
      ],
      calculate: (subjects) => {
        let totalGP = 0;
        let count = 0;

        subjects.forEach((sub) => {
          const marks = Number(sub.score) || 0;
          let gp = 0;
          if (marks >= 91) gp = 10;
          else if (marks >= 81) gp = 9;
          else if (marks >= 71) gp = 8;
          else if (marks >= 61) gp = 7;
          else if (marks >= 51) gp = 6;
          else if (marks >= 41) gp = 5;
          else if (marks >= 33) gp = 4;
          else gp = 0;

          totalGP += gp;
          count++;
        });

        const cgpa = count > 0 ? Number((totalGP / count).toFixed(2)) : 0;
        const percentage = Number((cgpa * 9.5).toFixed(2));
        
        let label = 'Average';
        let labelClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-400';
        if (cgpa >= 9.0) {
          label = 'Outstanding';
          labelClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-400';
        } else if (cgpa >= 8.0) {
          label = 'Excellent';
          labelClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-400';
        } else if (cgpa >= 6.0) {
          label = 'Good';
          labelClass = 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/40 dark:text-indigo-400';
        }

        return {
          cgpa,
          percentage,
          label,
          labelClass,
          note: `CBSE conversion rule applied: Percentage = ${cgpa} × 9.5 = ${percentage}%`
        };
      }
    },
    icse: {
      name: 'ICSE (CISCE)',
      description: 'ICSE (CISCE): Results are mark-based with letter grades A*-F. There is no official CGPA system. The unofficial CGPA shown here (percentage / 10) is used by many Indian colleges for reference only.',
      scoreType: 'marks',
      defaultSubjects: [
        { name: 'English Language', value: 85 },
        { name: 'English Literature', value: 78 },
        { name: 'Mathematics', value: 90 },
        { name: 'Science (Physics)', value: 82 },
        { name: 'Science (Chemistry)', value: 80 },
        { name: 'History & Geography', value: 75 }
      ],
      calculate: (subjects) => {
        let totalMarks = 0;
        let count = 0;

        subjects.forEach((sub) => {
          totalMarks += Number(sub.score) || 0;
          count++;
        });

        const percentage = count > 0 ? Number((totalMarks / count).toFixed(2)) : 0;
        const cgpa = Number((percentage / 10).toFixed(2));

        let label = 'Pass';
        let labelClass = 'bg-neutral-100 text-neutral-800 dark:bg-neutral-850/40 dark:text-neutral-400';
        if (percentage >= 90) {
          label = 'Outstanding (A*)';
          labelClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-400';
        } else if (percentage >= 80) {
          label = 'Excellent (A)';
          labelClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-400';
        } else if (percentage >= 70) {
          label = 'Very Good (B)';
          labelClass = 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/40 dark:text-indigo-400';
        } else if (percentage >= 60) {
          label = 'Good (C)';
          labelClass = 'bg-sky-100 text-sky-850 dark:bg-sky-950/40 dark:text-sky-400';
        } else if (percentage >= 40) {
          label = 'Average (D / E)';
          labelClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-400';
        } else {
          label = 'Fail (F)';
          labelClass = 'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-400';
        }

        return {
          cgpa,
          percentage,
          label,
          labelClass,
          note: `Unofficial CGPA calculation: Average Percentage (${percentage}%) ÷ 10 = ${cgpa}. Used by colleges for reference.`
        };
      }
    },
    'state-board': {
      name: 'State Board (Mark-Based)',
      description: 'State Boards generally issue results based on aggregate marks out of 100 per subject. There is no official CGPA system. The unofficial reference CGPA is calculated as (Average Percentage / 10), which is a common conversion benchmark used by universities.',
      scoreType: 'marks',
      defaultSubjects: [
        { name: 'First Language', value: 85 },
        { name: 'English', value: 78 },
        { name: 'Mathematics', value: 90 },
        { name: 'Science', value: 82 },
        { name: 'Social Science', value: 80 }
      ],
      calculate: (subjects) => {
        let totalMarks = 0;
        let count = 0;

        subjects.forEach((sub) => {
          totalMarks += Number(sub.score) || 0;
          count++;
        });

        const percentage = count > 0 ? Number((totalMarks / count).toFixed(2)) : 0;
        const cgpa = Number((percentage / 10).toFixed(2));

        let label = 'Second Class';
        let labelClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-400';
        if (percentage >= 75) {
          label = 'Distinction';
          labelClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-400';
        } else if (percentage >= 60) {
          label = 'First Class';
          labelClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-400';
        } else if (percentage >= 35) {
          label = 'Pass';
          labelClass = 'bg-neutral-100 text-neutral-800 dark:bg-neutral-850/40 dark:text-neutral-400';
        } else {
          label = 'Fail';
          labelClass = 'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-400';
        }

        return {
          cgpa,
          percentage,
          label,
          labelClass,
          note: `Unofficial CGPA calculation: Average Percentage (${percentage}%) ÷ 10 = ${cgpa}.`
        };
      }
    },
    igcse: {
      name: 'IGCSE (Cambridge / Pearson)',
      description: 'IGCSE uses a letter-grading system (A* to G or 9 to 1). There is no official cumulative CGPA. For credit mapping, IGCSE grades are commonly mapped to a standard 10-point scale: A* = 10, A = 9, B = 8, C = 7, D = 6, E = 5, F = 4, G = 3, U = 0.',
      scoreType: 'grades',
      defaultSubjects: [
        { name: 'First Language English', value: 'A' },
        { name: 'Mathematics', value: 'A*' },
        { name: 'Physics', value: 'A' },
        { name: 'Chemistry', value: 'A' },
        { name: 'Biology', value: 'B' },
        { name: 'Computer Science', value: 'B' }
      ],
      calculate: (subjects) => {
        const gradeMap: Record<string, number> = {
          'A*': 10, 'A': 9, 'B': 8, 'C': 7, 'D': 6, 'E': 5, 'F': 4, 'G': 3, 'U': 0
        };

        let totalGP = 0;
        let count = 0;

        subjects.forEach((sub) => {
          const grade = String(sub.score).trim();
          const gp = gradeMap[grade] !== undefined ? gradeMap[grade] : 0;
          totalGP += gp;
          count++;
        });

        const cgpa = count > 0 ? Number((totalGP / count).toFixed(2)) : 0;
        // Construct approximate percentage for display
        const percentage = Number((cgpa * 10).toFixed(1));

        let label = 'Pass';
        let labelClass = 'bg-neutral-100 text-neutral-800 dark:bg-neutral-850/40 dark:text-neutral-400';
        if (cgpa >= 9.0) {
          label = 'Excellent (A / A* Average)';
          labelClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-400';
        } else if (cgpa >= 7.5) {
          label = 'Very Good (B Average)';
          labelClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-400';
        } else if (cgpa >= 6.0) {
          label = 'Good (C Average)';
          labelClass = 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/40 dark:text-indigo-400';
        } else if (cgpa >= 4.0) {
          label = 'Average (D / E Average)';
          labelClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-400';
        }

        return {
          cgpa,
          percentage,
          label,
          labelClass,
          note: `IGCSE Scale used: A*=10, A=9, B=8, C=7, D=6, E=5, F=4, G=3, U=0. Average GPA = ${cgpa} out of 10.`
        };
      }
    }
  };

  // ── DOM References ──
  const boardSelect = document.getElementById('board-select') as HTMLSelectElement;
  const boardTabButtons = document.querySelectorAll('.board-tab-btn');
  const boardBanner = document.getElementById('board-banner')!;
  const rowsContainer = document.getElementById('subject-rows')!;
  const addBtn = document.getElementById('add-subject-btn')!;
  const calculateBtn = document.getElementById('calculate-btn')!;
  const scoreHeader = document.getElementById('score-header')!;
  
  const resultSection = document.getElementById('result-section')!;
  const resultContent = document.getElementById('result-content')!;
  const resultGpa = document.getElementById('result-gpa')!;
  const resultScale = document.getElementById('result-scale')!;
  const resultLabel = document.getElementById('result-label')!;
  const resultPercentage = document.getElementById('result-percentage')!;
  const resultNote = document.getElementById('result-note')!;
  const boardPrintBtn = document.getElementById('print-pdf-btn-board') as HTMLButtonElement;
  
  const gaugeRing = document.getElementById('gauge-ring') as HTMLElement;
  const gaugePercentText = document.getElementById('gauge-percent-text')!;

  let subjectCount = 0;

  // ── Helpers ──
  function getSelectedBoardKey() {
    return boardSelect.value;
  }

  function getSelectedBoardConfig() {
    return boardConfigs[getSelectedBoardKey()];
  }

  // Get grade string or GPA value from mark input
  function getGradeOrGPText(boardKey: string, scoreVal: number | string) {
    if (boardKey === 'igcse') {
      const gpMap: Record<string, number> = {
        'A*': 10, 'A': 9, 'B': 8, 'C': 7, 'D': 6, 'E': 5, 'F': 4, 'G': 3, 'U': 0
      };
      const grade = String(scoreVal);
      return `${gpMap[grade] || 0} GP`;
    }

    const marks = Number(scoreVal) || 0;
    if (boardKey === 'cbse') {
      if (marks >= 91) return 'A1 (10 GP)';
      if (marks >= 81) return 'A2 (9 GP)';
      if (marks >= 71) return 'B1 (8 GP)';
      if (marks >= 61) return 'B2 (7 GP)';
      if (marks >= 51) return 'C1 (6 GP)';
      if (marks >= 41) return 'C2 (5 GP)';
      if (marks >= 33) return 'D (4 GP)';
      return 'E (0 GP)';
    }

    if (boardKey === 'icse') {
      if (marks >= 90) return 'A* (Grade 1)';
      if (marks >= 80) return 'A (Grade 2)';
      if (marks >= 70) return 'B (Grade 3)';
      if (marks >= 60) return 'C (Grade 4)';
      if (marks >= 50) return 'D (Grade 5)';
      if (marks >= 40) return 'E (Grade 6)';
      return 'F (Fail)';
    }

    // State Board
    if (marks >= 90) return 'A+';
    if (marks >= 80) return 'A';
    if (marks >= 70) return 'B';
    if (marks >= 60) return 'C';
    if (marks >= 50) return 'D';
    if (marks >= 35) return 'E';
    return 'F';
  }

  function createSubjectRow(name = '', value: number | string = '') {
    subjectCount++;
    const rowId = subjectCount;
    const config = getSelectedBoardConfig();

    const row = document.createElement('div');
    row.className = 'grid grid-cols-[1fr_75px_100px_24px] sm:grid-cols-[1fr_140px_140px_40px] gap-0 sm:gap-4 items-center py-1 sm:py-1 sm:px-2 border-b border-neutral-100 sm:border-b-0 sm:border-neutral-100 sm:dark:border-neutral-800/50 bg-transparent animate-fade-up';
    row.setAttribute('role', 'listitem');
    row.dataset.rowId = String(rowId);

    // Score Input element
    let scoreInputHTML = '';
    if (config.scoreType === 'grades') {
      const grades = ['A*', 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'U'];
      scoreInputHTML = `
        <select aria-label="Grade" class="subject-score w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-none border-r-0 sm:rounded-xl sm:border px-2.5 py-1.5 text-xs sm:text-sm text-neutral-900 dark:text-neutral-100 focus:bg-white dark:focus:bg-neutral-900 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all cursor-pointer appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2024%2024%22%20stroke%3D%22%239ca3af%22%20stroke-width%3D%222%22%3E%3Cpath%20stroke-linecap%3D%22round%22%20d%3D%22M19%209l-7%207-7-7%22%2F%3E%3C%2Fsvg%3E')] bg-no-repeat bg-[right_0.4rem_center] bg-[length:0.8rem] pr-6 truncate">
          ${grades.map(g => `<option value="${g}" ${g === value ? 'selected' : ''}>${g}</option>`).join('')}
        </select>
      `;
    } else {
      scoreInputHTML = `
        <input
          type="number"
          min="0"
          max="100"
          value="${value}"
          placeholder="Marks"
          aria-label="Marks"
          class="subject-score w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-none border-r-0 sm:rounded-xl sm:border px-2.5 py-1.5 text-xs sm:text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-450 focus:bg-white dark:focus:bg-neutral-900 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all shadow-sm tabular-nums"
        />
      `;
    }

    row.innerHTML = `
      <div class="min-w-0">
        <input
          type="text"
          value="${name}"
          placeholder="e.g. Mathematics"
          aria-label="Subject name"
          class="subject-name w-full bg-neutral-50 dark:bg-neutral-955 border border-neutral-200 dark:border-neutral-800 rounded-l-xl rounded-r-none border-r-0 sm:rounded-xl sm:border px-2.5 py-1.5 text-xs sm:text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 focus:bg-white dark:focus:bg-neutral-900 focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all shadow-sm"
        />
      </div>
      <div class="min-w-0">
        ${scoreInputHTML}
      </div>
      <div class="min-w-0 py-1.5 text-xs sm:text-sm font-medium text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800 rounded-r-xl rounded-l-none sm:rounded-xl sm:border-0 sm:bg-transparent px-2.5 py-1.5 h-[34px] sm:h-auto flex items-center justify-center sm:justify-start truncate">
        <span class="preview-grade-text">${getGradeOrGPText(getSelectedBoardKey(), value)}</span>
      </div>
      <div class="flex items-center justify-center">
        <button
          type="button"
          aria-label="Remove subject"
          class="remove-btn w-6 h-6 sm:w-8 sm:h-8 flex items-center justify-center text-neutral-400 hover:text-red-500 dark:hover:text-red-400 transition-colors rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    `;

    // Event listeners
    const nameInput = row.querySelector('.subject-name') as HTMLInputElement;
    const scoreInput = row.querySelector('.subject-score') as HTMLInputElement | HTMLSelectElement;
    const previewSpan = row.querySelector('.preview-grade-text')!;
    const removeBtns = row.querySelectorAll('.remove-btn');

    const updatePreview = () => {
      previewSpan.textContent = getGradeOrGPText(getSelectedBoardKey(), scoreInput.value);
    };

    nameInput.addEventListener('input', calculate);
    scoreInput.addEventListener('input', () => {
      updatePreview();
      calculate();
    });
    
    removeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        row.remove();
        if (rowsContainer.children.length === 0) {
          createSubjectRow();
        }
        calculate();
      });
    });

    rowsContainer.appendChild(row);
  }

  function updateBoardTabStyles(boardKey: string) {
    boardTabButtons.forEach(btn => {
      const active = btn.getAttribute('data-board-tab') === boardKey;
      btn.className = `board-tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center ${
        active 
          ? "bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 shadow-sm border border-neutral-200/50 dark:border-neutral-800/40" 
          : "text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
      }`;
    });
  }

  // Load configuration for the selected board
  function initBoard() {
    const config = getSelectedBoardConfig();
    const boardKey = getSelectedBoardKey();

    // Update tab bar style
    updateBoardTabStyles(boardKey);

    // Update Header column name for desktop
    scoreHeader.textContent = config.scoreType === 'grades' ? 'Grade' : 'Marks';

    // Update dynamic explanation banner
    boardBanner.textContent = config.description;

    // Update Document Title & H1 Header dynamically
    const pageHeaderTitle = document.querySelector('h1');
    if (boardKey === 'icse') {
      document.title = 'FREE ICSE Percentage Calculator — CISCE Class 10/12 | CGPAHelper';
      if (pageHeaderTitle) pageHeaderTitle.innerHTML = 'FREE ICSE Percentage <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>';
    } else if (boardKey === 'cbse') {
      document.title = 'FREE CBSE CGPA to Percentage Calculator | CGPAHelper';
      if (pageHeaderTitle) pageHeaderTitle.innerHTML = 'FREE CBSE Percentage <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>';
    } else if (boardKey === 'state-board') {
      document.title = 'FREE State Board Percentage Calculator | CGPAHelper';
      if (pageHeaderTitle) pageHeaderTitle.innerHTML = 'FREE State Board Percentage <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>';
    } else if (boardKey === 'igcse') {
      document.title = 'FREE IGCSE GPA Calculator | CGPAHelper';
      if (pageHeaderTitle) pageHeaderTitle.innerHTML = 'FREE IGCSE GPA <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>';
    }

    // Reset rows and add default subjects
    rowsContainer.innerHTML = '';
    config.defaultSubjects.forEach((sub) => {
      createSubjectRow(sub.name, sub.value);
    });

    calculate();
  }

  // Calculate results
  function calculate() {
    const config = getSelectedBoardConfig();
    const rows = Array.from(rowsContainer.querySelectorAll('[data-row-id]'));
    
    const subjectData = rows.map((row) => {
      const nameInput = row.querySelector('.subject-name') as HTMLInputElement;
      const scoreInput = row.querySelector('.subject-score') as HTMLInputElement | HTMLSelectElement;
      return {
        name: nameInput.value,
        score: scoreInput.value
      };
    });

    // Make sure we have some input to calculate
    const hasData = subjectData.some((sub) => sub.score !== '');
    if (!hasData) {
      resultSection.style.display = 'none';
      return;
    }

    const res = config.calculate(subjectData);

    // Update DOM results
    resultSection.style.display = 'flex';
    resultGpa.textContent = res.cgpa.toFixed(2);
    resultScale.textContent = getSelectedBoardKey() === 'igcse' ? 'GPA' : 'Unofficial CGPA';
    
    if (getSelectedBoardKey() === 'cbse') {
      resultScale.textContent = 'CGPA';
    }

    resultLabel.textContent = res.label;
    resultLabel.className = `inline-block text-xs font-semibold px-2.5 py-1 rounded-full ${res.labelClass}`;
    resultPercentage.textContent = `Percentage: ${res.percentage}%`;
    resultNote.textContent = res.note;

    // Pulse result
    resultContent.classList.remove('result-pop');
    void resultContent.offsetWidth; // Trigger reflow
    resultContent.classList.add('result-pop');

    // Update Linear Progress Bar
    const cgpaPercent = Math.min(100, Math.max(0, (res.cgpa / 10) * 100));
    gaugeRing.style.width = `${cgpaPercent}%`;
    gaugePercentText.textContent = `${Math.round(res.percentage)}%`;
  }

  async function downloadPDF(btnElement: HTMLButtonElement) {
    const originalText = btnElement.innerHTML;
    btnElement.disabled = true;
    btnElement.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-neutral-500 inline-block" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Generating PDF...
    `;

    try {
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageWidth = doc.internal.pageSize.getWidth();
      const margin = 20;
      let y = 25;

      const boardKey = getSelectedBoardKey() || 'icse';
      const boardConfig = boardConfigs[boardKey] || boardConfigs['icse'];

      // ── Header ──
      doc.setFontSize(20);
      doc.setFont('helvetica', 'bold');
      const headerText = `${boardConfig ? boardConfig.name : 'Board'} Calculation Report`;
      doc.text(headerText, pageWidth / 2, y, { align: 'center' });
      y += 8;

      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(120);
      doc.text('Generated by CGPAHelper.com', pageWidth / 2, y, { align: 'center' });
      y += 4;

      // Divider line
      doc.setDrawColor(200);
      doc.setLineWidth(0.5);
      doc.line(margin, y, pageWidth - margin, y);
      y += 10;

      // ── Meta info ──
      doc.setTextColor(60);
      doc.setFontSize(11);
      const dateVal = new Date().toLocaleDateString(undefined, { dateStyle: 'long' });

      doc.setFont('helvetica', 'bold');
      doc.text('Date:', margin, y);
      doc.setFont('helvetica', 'normal');
      doc.text(dateVal, margin + 18, y);
      y += 7;

      doc.setFont('helvetica', 'bold');
      doc.text('Board / System:', margin, y);
      doc.setFont('helvetica', 'normal');
      doc.text(boardConfig ? boardConfig.name : 'Indian Boards', margin + 35, y);
      y += 12;

      // ── Result Summary ──
      const cgpaVal = resultGpa ? (resultGpa.textContent || '0.00') : '0.00';
      const scaleVal = resultScale ? (resultScale.textContent || 'CGPA') : 'CGPA';
      const pctVal = resultPercentage ? (resultPercentage.textContent || '') : '';
      const classificationVal = resultLabel ? (resultLabel.textContent || '') : '';

      doc.setFontSize(14);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30);
      doc.text(`${scaleVal}: ${cgpaVal}`, margin, y);
      y += 7;

      doc.setFontSize(11);
      doc.setFont('helvetica', 'bold');
      doc.text(pctVal, margin, y);
      y += 6;

      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100);
      doc.text(`Academic Standing: ${classificationVal}`, margin, y);
      y += 14;

      // ── Subjects Table ──
      const colWidths = [90, 35, 45];
      const scoreTypeLabel = boardConfig ? (boardConfig.scoreType === 'grades' ? 'Grade' : 'Marks') : 'Marks';
      const headers = ['Subject Name', scoreTypeLabel, 'Equivalent GP / Details'];
      const startX = margin;

      // Table header
      doc.setFillColor(245, 245, 245);
      doc.rect(startX, y - 5, colWidths[0] + colWidths[1] + colWidths[2], 8, 'F');
      doc.setFontSize(9);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(80);
      let x = startX + 3;
      headers.forEach((h, i) => {
        doc.text(h, x, y);
        x += colWidths[i];
      });
      y += 6;

      // Divider
      doc.setDrawColor(220);
      doc.setLineWidth(0.3);
      doc.line(startX, y, startX + colWidths[0] + colWidths[1] + colWidths[2], y);
      y += 5;

      // Table rows
      const rows = rowsContainer.querySelectorAll('[role="listitem"]');
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(50);
      doc.setFontSize(10);
      rows.forEach(row => {
        const nameInput = row.querySelector('.subject-name') as HTMLInputElement | null;
        const name = nameInput ? (nameInput.value || '—') : '—';
        
        const scoreInput = row.querySelector('.subject-score') as HTMLInputElement | HTMLSelectElement | null;
        const score = scoreInput ? (scoreInput.value || '0') : '0';
        
        const gpEl = row.querySelector('.preview-grade-text') as HTMLElement | null;
        const gpText = gpEl ? (gpEl.textContent || '—') : '—';

        x = startX + 3;
        doc.text(name.substring(0, 35), x, y);
        x += colWidths[0];
        doc.text(score, x, y);
        x += colWidths[1];
        doc.text(gpText, x, y);
        y += 7;

        if (y > 270) {
          doc.addPage();
          y = 25;
        }
      });

      // ── Footer ──
      y += 10;
      if (y > 260) {
        doc.addPage();
        y = 25;
      }
      doc.setDrawColor(200);
      doc.setLineWidth(0.3);
      doc.line(margin, y, pageWidth - margin, y);
      y += 6;
      doc.setFontSize(8);
      doc.setTextColor(150);
      doc.text('Disclaimer: This report represents a mathematical calculation based on school board rules. Verify with your official marksheet.', margin, y);
      y += 5;
      doc.text(`Generated on ${dateVal} by CGPAHelper.com`, margin, y);

      doc.save(`${boardKey.toUpperCase()}-Board-Report.pdf`);
    } catch (err) {
      console.error('PDF generation failed:', err);
      alert('Failed to generate PDF. Please try again.');
    } finally {
      btnElement.disabled = false;
      btnElement.innerHTML = originalText;
    }
  }

  // ── Setup Listeners ──
  if (boardSelect) {
    boardSelect.addEventListener('change', initBoard);
  }
  if (boardPrintBtn) {
    boardPrintBtn.addEventListener('click', () => {
      downloadPDF(boardPrintBtn);
    });
  }

  // Bind board tab button clicks
  boardTabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const boardKey = btn.getAttribute('data-board-tab')!;
      boardSelect.value = boardKey;
      initBoard();

      // Update URL query parameter
      const url = new URL(window.location.href);
      url.searchParams.set('board', boardKey);
      window.history.replaceState(null, '', url.toString());
    });
  });
  
  addBtn.addEventListener('click', () => {
    const config = getSelectedBoardConfig();
    const defaultValue = config.scoreType === 'grades' ? 'A' : '';
    createSubjectRow('', defaultValue);
  });

  calculateBtn.addEventListener('click', calculate);

  // Quick link navigation links
  document.querySelectorAll('[data-board-link]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const boardKey = btn.getAttribute('data-board-link')!;
      boardSelect.value = boardKey;
      initBoard();
      // Scroll smoothly to select
      boardSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  // Handle Query Param or Hash routing
  function checkUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const boardParam = params.get('board');
    if (boardParam && boardConfigs[boardParam]) {
      boardSelect.value = boardParam;
    } else {
      const hash = window.location.hash.replace('#', '');
      if (hash && boardConfigs[hash]) {
        boardSelect.value = hash;
      }
    }
    initBoard();
  }

  // Run on startup
  checkUrlParams();
</script>
