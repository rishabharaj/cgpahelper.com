  // ── TAB SWITCHING LOGIC ──
  function switchTab(tabName: string, updateUrl = true) {
    activeTabName = tabName;

    // 1. Update Tab Buttons style to show segmented iOS controls
    tabButtons.forEach(btn => {
      const active = btn.getAttribute('data-tab') === tabName;
      if (active) {
        btn.className = "tab-btn px-3 py-2 sm:px-4 text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer whitespace-nowrap bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 shadow-sm border border-neutral-200/50 dark:border-neutral-800/40";
      } else {
        btn.className = "tab-btn px-3 py-2 sm:px-4 text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer whitespace-nowrap text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100";
      }
    });

    // 2. Toggle Headers, Panels, FAQs, and Guides
    headers.forEach(h => h.id === `header-${tabName}` ? h.classList.remove('hidden') : h.classList.add('hidden'));
    panels.forEach(p => p.id === `panel-${tabName}` ? p.classList.remove('hidden') : p.classList.add('hidden'));
    faqPanels.forEach(f => f.id === `faq-panel-${tabName}` ? f.classList.remove('hidden') : f.classList.add('hidden'));
    guidePanels.forEach(g => g.id === `guide-panel-${tabName}` ? g.classList.remove('hidden') : g.classList.add('hidden'));

    // 3. Toggle System Selector Wrappers & Reference Blocks
    if (tabName === 'sgpa' || tabName === 'cgpa') {
      sharedSystemSelectWrapper.classList.remove('hidden');
      pctSystemSelectWrapper.classList.add('hidden');
      refBlockGrading.classList.remove('hidden');
      refBlockPercentage.classList.add('hidden');
      
      updateCgpaMaxGPAValidation();
      rebuildSgpaGradeDropdowns();
      updateSharedGradingTable();
      
      if (tabName === 'sgpa') calculateSgpa();
      else calculateCgpa();
    } else if (tabName === 'percentage') {
      sharedSystemSelectWrapper.classList.add('hidden');
      pctSystemSelectWrapper.classList.remove('hidden');
      refBlockGrading.classList.add('hidden');
      refBlockPercentage.classList.remove('hidden');
      
      updatePctFormulaPreview();
      updatePctRefTable();
      calculatePercentage();
    }

    // 4. Update Breadcrumb Active text
    let label = 'CGPA Calculator';
    if (tabName === 'sgpa') label = 'Semester GPA Calculator';
    else if (tabName === 'percentage') label = 'Percentage Converter';
    breadcrumbActive.textContent = label;

    // 5. Update URL state without page reload
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('tab', tabName);
      if (tabName !== 'percentage') {
        url.searchParams.delete('mode');
      }
      window.history.replaceState(null, '', url.toString());
    }
  }

  // Bind tab clicks
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) switchTab(tab);
    });
  });

  // Load correct tab on load based on URL params
  function initTabFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const tabParam = params.get('tab');
    if (tabParam && ['sgpa', 'cgpa', 'percentage'].includes(tabParam)) {
      switchTab(tabParam, false);
      if (tabParam === 'percentage') {
        const modeParam = params.get('mode');
        if (modeParam === 'from-percentage') {
          setPercentageMode('pct-to-gpa');
        } else {
          setPercentageMode('gpa-to-pct');
        }
      }
    } else {
