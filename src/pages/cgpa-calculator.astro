---
import Layout from '../layouts/Layout.astro';
import { gradingSystems } from '../data/grading-systems.js';

const title = 'FREE CGPA Calculator — GPA & CGPA Calculator | CGPAHelper';
const description = 'Free online academic calculators. Calculate your Semester GPA (SGPA), Cumulative GPA (CGPA), and convert CGPA to percentage in real time. Pre-loaded with official university grading scales.';

const sgpaFaqs = [
  { question: 'What is SGPA and how is it different from CGPA?', answer: 'SGPA (Semester Grade Point Average) measures your academic performance for a single semester. CGPA (Cumulative Grade Point Average) is the weighted average across all semesters. SGPA focuses on one semester\'s courses, while CGPA combines all semesters.' },
  { question: 'How is SGPA calculated?', answer: 'SGPA is calculated using the formula: SGPA = Σ(Grade Point × Credit Hours) ÷ Σ(Credit Hours). Multiply each course\'s grade point by its credit hours, sum all these products, then divide by the total credit hours for the semester.' },
  { question: 'What are credit hours?', answer: 'Credit hours represent the weightage or workload of a course. Typically, lecture courses carry 3-4 credits, lab courses carry 1-2 credits, and project/thesis courses may carry 4-6 credits. More credits mean the course has a greater impact on your SGPA.' },
  { question: 'Can I calculate SGPA for different universities?', answer: 'Yes! Our calculator supports all standard grading scales, including the standard 10-point scale (common for VIT, SRM, KTU Kerala, AKTU UP, Anna University, JNTU, SPPU), CBSE/UGC India 10-point, Mumbai University, Standard 4.0 scale (common for US, Canada, HEC Pakistan, UGC Bangladesh, BRACU, NSU, COMSATS), and the Standard 5.0 scale.' },
  { question: 'Does a failing grade affect my SGPA?', answer: 'Yes, a failing grade (F) carries 0 grade points but the credit hours still count in the total. This significantly lowers your SGPA. For example, failing a 4-credit course adds 0 to grade points but adds 4 to total credits, pulling your average down.' },
  { question: 'How can I improve my SGPA?', answer: 'Focus on high-credit courses as they have more impact on your SGPA. Aim for higher grades in these courses. Also, avoid failing any course since F grades drastically reduce your SGPA. Consistent study and regular attendance help maintain a good SGPA.' },
];

const cgpaFaqs = [
  { question: 'What is CGPA and how is it calculated?', answer: 'CGPA (Cumulative Grade Point Average) is the weighted average of your semester GPAs. It is calculated using the formula: CGPA = Σ(Semester GPA × Credit Hours) ÷ Σ(Credit Hours). Each semester\'s GPA is weighted by the number of credit hours completed in that semester.' },
  { question: 'What is the difference between SGPA and CGPA?', answer: 'SGPA (Semester Grade Point Average) is your GPA for a single semester, calculated from individual course grades. CGPA is your overall GPA across all semesters, calculated by weighting each semester\'s GPA by its credit hours. CGPA gives a holistic view of your academic performance.' },
  { question: 'Why do I need to enter credit hours?', answer: 'Credit hours reflect the weightage of each semester. A semester with more credit hours has a greater impact on your cumulative GPA. Without credit hours, the calculator would treat all semesters equally, which may not reflect your actual performance accurately.' },
  { question: 'Can I use this calculator for any university?', answer: 'Yes! Our calculator supports all standard grading scales, including the standard 10-point scale (common for VIT, SRM, KTU Kerala, AKTU UP, Anna University, JNTU, SPPU), CBSE/UGC India 10-point, Mumbai University, Standard 4.0 scale (common for US, Canada, HEC Pakistan, UGC Bangladesh, BRACU, NSU, COMSATS), and the Standard 5.0 scale.' },
  { question: 'How accurate is this CGPA calculator?', answer: 'Our calculator uses the standard weighted average formula used by universities worldwide. Results are accurate to two decimal places. The GPA input validation adjusts based on your selected grading system\'s maximum GPA. Always verify with your university\'s official records for final decisions.' },
  { question: 'Is my data safe?', answer: 'Absolutely. All calculations run entirely in your browser using JavaScript. No data is sent to any server, stored in any database, or shared with anyone. Your academic information stays completely private.' },
];

const percentageFaqs = [
  { question: 'How do I convert CGPA to percentage?', answer: 'The formula depends on your university. For CBSE/UGC India, multiply your CGPA by 9.5 (e.g., 8.5 CGPA = 80.75%). For most 4.0-scale systems (HEC Pakistan, US), multiply by 25. For Mumbai University, use: Percentage = (7.1 × CGPA) + 11. Select your grading system above for the exact formula.' },
  { question: 'What is the CBSE formula for CGPA to percentage?', answer: 'The official CBSE formula is: Percentage = CGPA × 9.5. This formula is approved by UGC India and is widely used across Indian universities following the 10-point grading scale. For example, a CGPA of 9.0 equals 85.5%.' },
  { question: 'Is the percentage to CGPA conversion accurate?', answer: 'Yes. We use the exact official conversion formulas specified by each university or governing body. Results are calculated to two decimal places. However, always cross-check with your university\'s official records for final academic decisions.' },
  { question: 'Can I convert percentage to CGPA on a 4.0 scale?', answer: 'Yes! Select any 4.0-scale system such as HEC Pakistan, UGC Bangladesh, COMSATS, or the US 4.0 Scale. The formula is typically CGPA = Percentage ÷ 25. For example, 80% equals 3.20 on a 4.0 scale.' },
  { question: 'Which universities are supported?', answer: 'Our converter supports all standard grading scales, including the standard 10-point scale (common for VIT, SRM, KTU Kerala, AKTU UP, Anna University, JNTU, SPPU), CBSE/UGC India 10-point, Mumbai University, Standard 4.0 scale (common for US, Canada, HEC Pakistan, UGC Bangladesh, BRACU, NSU, COMSATS), and the Standard 5.0 scale.' },
  { question: 'Why does Mumbai University use a different formula?', answer: 'Mumbai University uses a linear formula (CGPA = (Percentage − 11) ÷ 7.1) rather than a simple division. This is the officially prescribed conversion method that accounts for the university\'s specific grading distribution.' },
];

const systemEntries = Object.entries(gradingSystems).filter(([key]) => {
  return [
    'us-4-0',
    'cbse-ugc-india',
    'pk-bd-unis',
    'aus-7-0',
    'can-4-33',
    'ects',
    'uk-honours',
    'sg-5-0',
    'nz-9-0',
    'my-4-0'
  ].includes(key);
});
---

<Layout title={title} description={description}>
  <!-- ── Breadcrumb ── -->
  <nav aria-label="Breadcrumb" class="container-page pt-6 pb-2">
    <ol class="flex items-center gap-1.5 text-xs text-neutral-400 dark:text-neutral-500">
      <li>
        <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">Home</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <span id="breadcrumb-active" class="text-neutral-700 dark:text-neutral-200 font-medium" aria-current="page">CGPA Calculator</span>
      </li>
    </ol>
  </nav>

  <!-- ── Page Header ── -->
  <header class="container-page pt-6 pb-8 md:pt-8 md:pb-10 print:hidden">
    <!-- SGPA Header -->
    <div id="header-sgpa" class="tab-header hidden">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] mb-3">
        Semester GPA <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed text-sm sm:text-base">
        Calculate your Semester GPA by entering course names, credit hours, and selecting grades. Results update dynamically in real time.
      </p>
    </div>

    <!-- CGPA Header -->
    <div id="header-cgpa" class="tab-header hidden">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] mb-3">
        CGPA <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed text-sm sm:text-base">
        Enter your semester GPAs and credit hours to calculate your cumulative GPA. Supports standard 10-point, 4.0, and 5.0 scales.
      </p>
    </div>

    <!-- Percentage Header -->
    <div id="header-percentage" class="tab-header hidden">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] mb-3">
        Percentage <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Converter</span>
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed text-sm sm:text-base">
        Convert your Cumulative GPA to percentage and vice-versa using official university formulas. Select your system for instant results.
      </p>
    </div>
  </header>

  <!-- ── Integrated Calculator Card ── -->
  <section class="container-page pb-16">
    <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl shadow-sm overflow-hidden">
      
      <!-- Card Header: Tabs & Grading System Inline -->
      <div class="px-4 py-4 sm:px-6 md:px-8 border-b border-neutral-200 dark:border-neutral-800 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-neutral-900">
        
        <!-- Tabs Segmented Control -->
        <div class="flex w-full sm:w-auto p-1 bg-neutral-100 dark:bg-neutral-800 rounded-xl gap-1 print:hidden">
          <button
            type="button"
            data-tab="sgpa"
            class="tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="block sm:inline-block">Semester</span> <span class="block sm:inline-block">GPA</span>
          </button>
          <button
            type="button"
            data-tab="cgpa"
            class="tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="block sm:inline-block">CGPA</span> <span class="block sm:inline-block">Calculator</span>
          </button>
          <button
            type="button"
            data-tab="percentage"
            class="tab-btn flex-1 sm:flex-initial px-2 py-2 sm:px-4 text-[10px] xs:text-xs sm:text-sm font-semibold rounded-lg transition-all cursor-pointer text-center text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="block sm:inline-block">Percentage</span> <span class="block sm:inline-block">Converter</span>
          </button>
        </div>

        <!-- Right Side: Grading System Selector -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0 print:hidden">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-mono">Grading System</span>
          
          <!-- Shared Dropdown for SGPA / CGPA -->
          <div id="shared-system-select-wrapper" class="relative w-full min-w-[160px] sm:w-64 custom-dropdown">
            <button
              type="button"
              class="custom-dropdown-trigger w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-800 dark:text-neutral-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors cursor-pointer flex items-center justify-between gap-2"
            >
              <span class="custom-dropdown-selected-text">Loading...</span>
              <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="custom-dropdown-options hidden absolute right-0 z-50 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg shadow-lg py-1 text-sm focus:outline-none">
              {systemEntries.map(([key, sys]) => (
                <div role="option" data-value={key} class="custom-dropdown-option cursor-pointer select-none relative py-2 px-4 text-neutral-900 dark:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                  {sys.shortName || sys.name}
                </div>
              ))}
            </div>
            <select id="grading-system-select" aria-label="Select grading system" class="sr-only">
              {systemEntries.map(([key, sys]) => (
                <option value={key}>{sys.shortName || sys.name}</option>
              ))}
            </select>
          </div>

          <!-- Selector for Percentage Converter -->
          <div id="pct-system-select-wrapper" class="relative w-full min-w-[160px] sm:w-64 custom-dropdown hidden">
            <button
              type="button"
              class="custom-dropdown-trigger w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-800 dark:text-neutral-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors cursor-pointer flex items-center justify-between gap-2"
            >
              <span class="custom-dropdown-selected-text">Loading...</span>
              <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="custom-dropdown-options hidden absolute right-0 z-50 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg shadow-lg py-1 text-sm focus:outline-none">
              {Object.entries(gradingSystems).map(([key, sys]) => (
                <div role="option" data-value={key} class="custom-dropdown-option cursor-pointer select-none relative py-2 px-4 text-neutral-900 dark:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                  {sys.shortName || sys.name}
                </div>
              ))}
            </div>
            <select id="pct-system-select" aria-label="Select grading system" class="sr-only">
              {Object.entries(gradingSystems).map(([key, sys]) => (
                <option value={key}>{sys.shortName || sys.name}</option>
              ))}
            </select>
          </div>

        </div>
      </div>

      <!-- Card Body containing active Panel -->
      <div class="p-4 sm:p-6 md:p-8">

        <!-- 1. SEMESTER GPA PANEL -->
        <div id="panel-sgpa" class="tab-panel hidden animate-fade-up">
          <!-- Course Table -->
          <div>
            <div class="grid grid-cols-[1fr_70px_110px_24px] sm:grid-cols-[1fr_120px_180px_40px] gap-1.5 sm:gap-3 mb-2 px-1">
              <span class="text-[9px] sm:text-xs font-mono text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Course Name</span>
              <span class="text-[9px] sm:text-xs font-mono text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Credit Hours</span>
              <span class="text-[9px] sm:text-xs font-mono text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Grade</span>
              <span></span>
            </div>

            <div id="courses-container-sgpa" class="space-y-1.5" role="list" aria-label="Course list">
              <!-- Populated by JS -->
            </div>

            <button
              id="add-course-btn-sgpa"
              type="button"
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors cursor-pointer"
            >
              <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Add Course
            </button>
          </div>

          <!-- SGPA Result -->
          <div id="result-section-sgpa" class="border-t border-neutral-200 dark:border-neutral-800 pt-8 mt-8 flex flex-col sm:flex-row items-center gap-6 sm:gap-10" style="display:none;">
            <div class="w-full sm:w-48 shrink-0 space-y-2">
              <div class="flex justify-between text-xs font-semibold text-neutral-500 dark:text-neutral-400 font-mono">
                <span>0%</span>
                <span id="gauge-percent-text-sgpa">0%</span>
              </div>
              <div class="w-full bg-neutral-100 dark:bg-neutral-800 h-3 rounded-full overflow-hidden">
                <div id="gauge-ring-sgpa" class="h-full rounded-full transition-all duration-500 ease-out" style="width: 0%; background-color: #4f46e5;"></div>
              </div>
            </div>

            <div id="result-content-sgpa" class="text-center sm:text-left flex-1">
              <div class="flex items-baseline justify-center sm:justify-start gap-1.5">
                <span class="text-neutral-500 dark:text-neutral-400 text-sm font-medium">Semester GPA</span>
                <span id="result-gpa-sgpa" class="text-4xl md:text-5xl font-semibold tracking-tight tabular-nums ml-2">0.00</span>
                <span id="result-scale-sgpa" class="text-lg text-neutral-400 dark:text-neutral-500 font-medium">/ 10.0</span>
              </div>
              <div class="mt-2 flex flex-wrap items-center justify-center sm:justify-start gap-2">
                <span id="result-classification-sgpa" class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full"></span>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 font-mono">
                  Total Credits: <strong id="result-credits-sgpa" class="text-neutral-900 dark:text-neutral-100">0</strong> |
                  Points: <strong id="result-points-sgpa" class="text-neutral-900 dark:text-neutral-100">0.00</strong>
                </span>
              </div>
            </div>

            <div class="sm:ml-auto w-full sm:w-auto flex justify-center print:hidden">
              <button
                id="print-pdf-btn-sgpa"
                type="button"
                class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-2.5 border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer text-neutral-700 dark:text-neutral-300"
              >
                <svg class="w-4 h-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download PDF
              </button>
            </div>
          </div>
        </div>

        <!-- 2. CGPA CALCULATOR PANEL -->
        <div id="panel-cgpa" class="tab-panel hidden animate-fade-up">
          <!-- Semesters Table -->
          <div>
            <div class="grid grid-cols-[1fr_65px_85px_24px] sm:grid-cols-[1fr_140px_140px_40px] gap-1.5 sm:gap-3 mb-3 px-1">
              <span class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Semester</span>
              <span class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">GPA</span>
              <span class="font-mono text-[9px] sm:text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Credit Hours</span>
              <span class="sr-only">Remove</span>
            </div>

            <div id="semester-rows-cgpa" class="space-y-1.5" role="list" aria-label="Semester entries">
              <!-- Populated by JS -->
            </div>

            <button
              id="add-semester-btn-cgpa"
              type="button"
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors cursor-pointer"
            >
              <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Add Semester
            </button>
          </div>

          <!-- CGPA Result Section -->
          <div id="result-section-cgpa" class="border-t border-neutral-200 dark:border-neutral-800 pt-8 mt-8 flex flex-col sm:flex-row items-center gap-6 sm:gap-10" style="display:none;">
            <div class="w-full sm:w-48 shrink-0 space-y-2">
              <div class="flex justify-between text-xs font-semibold text-neutral-500 dark:text-neutral-400 font-mono">
                <span>0%</span>
                <span id="gauge-percent-text-cgpa">0%</span>
              </div>
              <div class="w-full bg-neutral-100 dark:bg-neutral-800 h-3 rounded-full overflow-hidden">
                <div id="gauge-ring-cgpa" class="h-full rounded-full transition-all duration-500 ease-out" style="width: 0%; background-color: #4f46e5;"></div>
              </div>
            </div>

            <div id="result-content-cgpa" class="text-center sm:text-left flex-1">
              <div class="flex items-baseline justify-center sm:justify-start gap-1.5">
                <span class="text-neutral-500 dark:text-neutral-400 text-sm font-medium">Cumulative CGPA</span>
                <span id="result-gpa-cgpa" class="text-4xl md:text-5xl font-semibold tracking-tight tabular-nums ml-2">0.00</span>
                <span id="result-scale-cgpa" class="text-lg text-neutral-400 dark:text-neutral-500 font-medium">/ 10.0</span>
              </div>
              <div class="mt-2 flex flex-wrap items-center justify-center sm:justify-start gap-2">
                <span id="result-label-cgpa" class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full"></span>
                <span id="result-credits-cgpa" class="text-xs text-neutral-400 dark:text-neutral-500 font-mono"></span>
              </div>
            </div>

            <div class="sm:ml-auto w-full sm:w-auto flex justify-center print:hidden">
              <button
                id="print-pdf-btn-cgpa"
                type="button"
                class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-2.5 border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer text-neutral-700 dark:text-neutral-300"
              >
                <svg class="w-4 h-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download PDF
              </button>
            </div>
          </div>
        </div>

        <!-- 3. PERCENTAGE CONVERTER PANEL -->
        <div id="panel-percentage" class="tab-panel hidden animate-fade-up">
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Left Column: Inputs -->
            <div class="min-w-0">
              <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-4">Conversion Parameters</h2>
              
              <!-- Mode Switcher -->
              <div class="mb-5">
                <label class="block text-sm font-medium mb-2">Conversion Type</label>
                <div class="inline-flex p-1 bg-neutral-100 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800/80 rounded-xl w-full">
                  <button
                    type="button"
                    id="percentage-mode-gpa-to-pct"
                    class="flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer"
                  >
                    CGPA to Percentage
                  </button>
                  <button
                    type="button"
                    id="percentage-mode-pct-to-gpa"
                    class="flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer"
                  >
                    Percentage to CGPA
                  </button>
                </div>
              </div>

              <!-- CGPA Input Container -->
              <div id="cgpa-input-container" class="mb-5">
                <label for="cgpa-input-field" class="block text-sm font-medium mb-2">Enter CGPA</label>
                <input
                  type="number"
                  id="cgpa-input-field"
                  step="0.01"
                  min="0"
                  max="10"
                  placeholder="e.g. 8.50"
                  class="w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl px-4 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-neutral-400 dark:placeholder:text-neutral-600 tabular-nums"
                />
