---
import Layout from '../layouts/Layout.astro';
import { gradingSystems } from '../data/grading-systems.js';

const title = 'CGPA Calculator — How to Calculate CGPA Online (4.0 & 10-Point Scale)';
const description = 'Free online CGPA calculator to calculate your Cumulative Grade Point Average. Supports 4.0 scale, 10-point scale, and 5.0 scale. Learn how to calculate CGPA with credit-weighted formulas for all universities.';

const faqs = [
  {
    question: 'What is CGPA and how is it calculated?',
    answer: 'CGPA (Cumulative Grade Point Average) is the weighted average of your semester GPAs. It is calculated using the formula: CGPA = Σ(Semester GPA × Credit Hours) ÷ Σ(Credit Hours). Each semester\'s GPA is weighted by the number of credit hours completed in that semester.',
  },
  {
    question: 'What is the difference between SGPA and CGPA?',
    answer: 'SGPA (Semester Grade Point Average) is your GPA for a single semester, calculated from individual course grades. CGPA is your overall GPA across all semesters, calculated by weighting each semester\'s GPA by its credit hours. CGPA gives a holistic view of your academic performance.',
  },
  {
    question: 'Why do I need to enter credit hours?',
    answer: 'Credit hours reflect the weightage of each semester. A semester with more credit hours has a greater impact on your cumulative GPA. Without credit hours, the calculator would treat all semesters equally, which may not reflect your actual performance accurately.',
  },
  {
    question: 'Can I use this calculator for any university?',
    answer: 'Yes! Our calculator supports all standard grading scales, including the standard 10-point scale (common for VIT, SRM, KTU Kerala, AKTU UP, Anna University, JNTU, SPPU), CBSE/UGC India 10-point, Mumbai University, Standard 4.0 scale (common for US, Canada, HEC Pakistan, UGC Bangladesh, BRACU, NSU, COMSATS), and the Standard 5.0 scale.',
  },
  {
    question: 'How accurate is this CGPA calculator?',
    answer: 'Our calculator uses the standard weighted average formula used by universities worldwide. Results are accurate to two decimal places. The GPA input validation adjusts based on your selected grading system\'s maximum GPA. Always verify with your university\'s official records for final decisions.',
  },
  {
    question: 'Is my data safe?',
    answer: 'Absolutely. All calculations run entirely in your browser using JavaScript. No data is sent to any server, stored in any database, or shared with anyone. Your academic information stays completely private.',
  },
];

// Build grading system entries for the select dropdown
const systemEntries = Object.entries(gradingSystems).filter(([key]) => {
  return [
    'us-4-0',
    'cbse-ugc-india',
    'icse-board',
    'pk-bd-unis',
    'aus-7-0',
    'can-4-33',
    'ects',
    'uk-honours',
    'sg-5-0',
    'nz-9-0',
    'my-4-0'
  ].includes(key);
});
---

<Layout title={title} description={description} faqs={faqs}>
  <!-- ── Breadcrumb ── -->
  <nav aria-label="Breadcrumb" class="container-page pt-6 pb-2">
    <ol class="flex items-center gap-1.5 text-xs text-neutral-400 dark:text-neutral-500">
      <li>
        <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">Home</a>
      </li>
      <li aria-hidden="true">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li>
        <span class="text-neutral-700 dark:text-neutral-200 font-medium" aria-current="page">CGPA Calculator</span>
      </li>
    </ol>
  </nav>

  <!-- ── Page Header ── -->
  <header class="container-page pt-6 pb-10 md:pt-8 md:pb-14">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] mb-4">
      CGPA <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 bg-clip-text text-transparent">Calculator</span>
    </h1>
    <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Enter your semester GPAs and credit hours to calculate your cumulative GPA. Supports standard 10-point, 4.0, and 5.0 grading scales — results update in real time.
    </p>
  </header>

  <!-- ── Calculator Card ── -->
  <section class="container-page pb-16">
    <!-- Formula Explanation -->
    <div class="mb-6 p-5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm">
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">
        This is a simple CGPA calculator that calculates your CGPA based on your grades and credits:
      </p>
      <div class="flex items-center justify-center py-2 select-none">
        <div class="flex items-center font-sans text-neutral-800 dark:text-neutral-100">
          <span class="text-base sm:text-lg font-medium mr-4">CGPA =</span>
          <div class="flex flex-col items-center">
            <span class="px-4 pb-1.5 border-b border-neutral-300 dark:border-neutral-700 text-sm sm:text-base font-medium">
              &sum;<sub>i=1</sub><sup>n</sup> (grade<sub>i</sub> &times; credit<sub>i</sub>)
            </span>
            <span class="px-4 pt-1.5 text-sm sm:text-base font-medium">
              &sum;<sub>i=1</sub><sup>n</sup> credit<sub>i</sub>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-sm overflow-hidden">
      <!-- Card header -->
      <div class="px-5 py-4 md:px-6 border-b border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 min-w-0">
        <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 shrink-0">Grading System</span>
        <div class="relative w-full max-w-full sm:w-auto sm:max-w-md flex-1 custom-dropdown">
          <button
            type="button"
            class="custom-dropdown-trigger w-full bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-lg px-4 py-2 text-sm font-medium text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors cursor-pointer flex items-center justify-between gap-2"
          >
            <span class="custom-dropdown-selected-text">Loading...</span>
            <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="custom-dropdown-options hidden absolute left-0 right-0 z-50 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg shadow-lg py-1 text-sm focus:outline-none">
            {systemEntries.map(([key, sys]) => (
              <div
                role="option"
                data-value={key}
                class="custom-dropdown-option cursor-pointer select-none relative py-2 px-4 text-neutral-900 dark:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
              >
                {sys.shortName || sys.name}
              </div>
            ))}
          </div>
          <select
            id="grading-system-select"
            aria-label="Select grading system"
            class="sr-only"
          >
            {systemEntries.map(([key, sys]) => (
              <option value={key}>{sys.shortName || sys.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Semester table -->
      <div class="px-5 py-5 md:px-6">

        <!-- Table header (desktop) -->
        <div class="hidden sm:grid sm:grid-cols-[1fr_140px_140px_40px] gap-3 mb-3">
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Semester</span>
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">GPA</span>
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Credits</span>
          <span class="sr-only">Remove</span>
        </div>

        <!-- Rows container -->
        <div id="semester-rows" class="space-y-3" role="list" aria-label="Semester entries">
          <!-- Rows populated by JS -->
        </div>

        <!-- Add semester button -->
        <button
          id="add-semester-btn"
          type="button"
          class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Semester
        </button>
      </div>

      <!-- Result section -->
      <div id="result-section" class="border-t border-neutral-200 dark:border-neutral-800 px-5 py-8 md:px-6 flex flex-col sm:flex-row items-center gap-6 sm:gap-10" style="display:none;">
        <!-- Linear Progress Bar -->
        <div class="w-full sm:w-48 shrink-0 space-y-2">
          <div class="flex justify-between text-xs font-semibold text-neutral-500 dark:text-neutral-400 font-mono">
            <span>0%</span>
            <span id="gauge-percent-text">0%</span>
          </div>
          <div class="w-full bg-neutral-100 dark:bg-neutral-800 h-3 rounded-full overflow-hidden">
            <div
              id="gauge-ring"
              class="h-full rounded-full transition-all duration-500 ease-out"
              style="width: 0%; background-color: #4f46e5;"
            ></div>
          </div>
        </div>

        <!-- Text result -->
        <div id="result-content" class="text-center sm:text-left">
          <div class="flex items-baseline gap-1.5">
            <span id="result-gpa" class="text-4xl md:text-5xl font-semibold tracking-tight tabular-nums">0.00</span>
            <span id="result-scale" class="text-lg text-neutral-400 dark:text-neutral-500 font-medium">/ 10</span>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span id="result-label" class="inline-block text-sm font-medium px-2.5 py-0.5 rounded-full"></span>
            <span id="result-credits" class="text-sm text-neutral-400 dark:text-neutral-500"></span>
          </div>
        </div>

        <!-- Download PDF Button -->
        <div class="sm:ml-auto w-full sm:w-auto flex justify-center print:hidden">
          <button
            id="print-pdf-btn"
            type="button"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-2.5 border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer text-neutral-700 dark:text-neutral-300"
          >
            <svg class="w-4 h-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Download PDF
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Collapsible Grading Table ── -->
  <section class="container-page pb-16">
    <details id="grading-table-details" class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-sm overflow-hidden group">
      <summary class="flex items-center justify-between cursor-pointer px-5 py-4 md:px-6 text-sm font-medium select-none hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">
        <span>
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mr-2">Reference</span>
          Grade Table for <span id="grading-table-title" class="text-indigo-600 dark:text-indigo-400">UGC India</span>
        </span>
        <svg class="w-5 h-5 text-neutral-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5 md:px-6">
        <div class="overflow-x-auto">
          <table id="grading-table" class="w-full text-sm" role="table">
            <thead>
              <tr class="border-b border-neutral-200 dark:border-neutral-800">
                <th class="text-left font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 py-2 pr-4">Grade</th>
                <th class="text-left font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 py-2 pr-4">Points</th>
                <th class="text-left font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 py-2">Marks Range</th>
              </tr>
            </thead>
            <tbody id="grading-table-body">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </section>

  <!-- ── Comprehensive Academic Guide ── -->
  <section class="container-page pb-16">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-6">
        How to Calculate CGPA: A Step-by-Step Academic Guide
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Maintaining a strong academic record is crucial for both higher education and career progression. Your Cumulative Grade Point Average (CGPA) serves as a standardized measurement of your overall academic performance across semesters. Whether you are using a <strong>CGPA calculator</strong> to estimate your grades or looking to compute it manually, understanding the underlying <strong>CGPA calculation formula</strong> is essential. Our <strong>cumulative grade point average calculator</strong> simplifies this process, enabling students to <strong>calculate CGPA online</strong> in a matter of seconds.
      </p>
      
      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        The Standard CGPA Formula
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        To calculate your CGPA, you must divide the sum of all grade points earned in all semesters by the sum of all credit hours attempted. This is also referred to as a <strong>credit weighted GPA</strong> because courses with higher credit counts have a greater influence on your final grade.
      </p>
      <div class="p-5 my-4 bg-indigo-50/50 dark:bg-indigo-950/20 rounded-xl border border-indigo-100 dark:border-indigo-900/30 text-center font-mono text-base sm:text-lg text-indigo-700 dark:text-indigo-400">
        CGPA = Total (Semester GPA × Semester Credits) ÷ Total Credits
      </div>
      
      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        Worked Example of Credit-Weighted CGPA
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Let us look at a worked example of how a student can perform a <strong>semester GPA to CGPA</strong> calculation. Suppose you have completed three semesters with the following grades:
      </p>
      <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
        <li><strong>Semester 1:</strong> GPA of 8.20 with 20 credits (Product = 8.20 × 20 = 164)</li>
        <li><strong>Semester 2:</strong> GPA of 7.80 with 22 credits (Product = 7.80 × 22 = 171.6)</li>
        <li><strong>Semester 3:</strong> GPA of 8.50 with 18 credits (Product = 8.50 × 18 = 153)</li>
      </ul>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Summing these up, the total quality points earned are 164 + 171.6 + 153 = 488.6. The total credits attempted are 20 + 22 + 18 = 60. By applying the formula: 488.6 ÷ 60 = <strong>8.14 CGPA</strong>. This step-by-step example demonstrates <strong>how to calculate CGPA</strong> accurately when credit distributions differ between semesters.
      </p>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        Why Universities and Recruitment Boards Weight CGPA by Course Credits
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Many first-year college students wonder why a simple arithmetic average is not used to calculate cumulative grades. The answer lies in academic course design. Core academic subjects (like Advanced Mathematics or Data Structures) typically demand a high volume of lecture hours, lab work, and assignments. Consequently, universities assign these classes high credit values (e.g., 4.0 or 5.0 credits). Conversely, elective seminars, physical education, or introductory labs are often assigned lower weights (e.g., 1.0 or 2.0 credits). 
      </p>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        A credit-weighted CGPA ensures that your grade in a demanding 4-credit course has double the mathematical impact of your grade in a 2-credit course. This gives a more accurate representation of your academic dedication and performance in your primary field of study. When employers and admissions panels review a transcript, they look closely at how you performed in these high-credit core subjects.
      </p>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        CGPA Grading Scales: 10-Point Scale vs 4.0 Scale
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Grading systems vary worldwide. Most Indian universities and technical institutes (such as IITs, NITs, and universities following the UGC guidelines) use a <strong>CGPA 10 point scale</strong>. On the other hand, North American universities, including those in the United States and Canada, evaluate students on a <strong>CGPA 4.0 scale</strong>. 
      </p>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        In addition to the 10-point scale used in countries like India (governed by boards like CBSE and universities adopting the UGC Choice-Based Credit System), there are other scales like the Australian 7-point scale, the British honours classification system, and the German Bavarian scale. Each scale has unique passing requirements and conversions. For example, a 6.0 CGPA on an Indian 10-point scale translates differently to a US GPA than a 6.0 on a 7-point scale. Knowing your target scale is essential for international credential evaluations.
      </p>
      <div class="p-5 my-4 bg-amber-50/50 dark:bg-amber-950/20 rounded-xl border border-amber-100 dark:border-amber-900/30">
        <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">
          💡 <strong>Tip:</strong> If you are planning to apply for study abroad opportunities, you will need to convert your 10-point Indian CGPA to a US 4.0 GPA. Check out our specialized <a href="/cgpa-to-gpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">CGPA to GPA Converter</a> to get an instant estimate.
        </p>
      </div>

      <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mt-8 mb-3">
        Tips to Improve Your Cumulative CGPA
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        If you want to raise your cumulative average, focus on these actionable strategies:
      </p>
      <ul class="list-disc list-inside space-y-2 text-neutral-600 dark:text-neutral-400 mb-6 ml-4">
        <li><strong>Prioritize High-Credit Courses:</strong> Core subjects with 4 or 5 credits have a massive impact on your average. Devote extra study hours to these classes.</li>
        <li><strong>Track Your Semester Progress:</strong> Use our <a href="/sgpa-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline">SGPA Calculator</a> to calculate your semester GPA before final grades are published to identify where you need to improve.</li>
        <li><strong>Convert Grades Regularly:</strong> Convert your CGPA to other formats like percentages using our <a href="/cgpa-to-percentage" class="text-indigo-600 dark:text-indigo-400 hover:underline">CGPA to Percentage tool</a> to meet the requirements of job recruiters who demand percentage metrics.</li>
      </ul>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        Using this cumulative grade point average calculator consistently helps you set realistic targets, track your progress semester by semester, and ensure you remain on track to achieve your academic goals.
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="bg-white dark:bg-neutral-900 border-y border-neutral-200 dark:border-neutral-800">
    <div class="container-page py-16 md:py-20">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-mono mb-2 block">FAQ</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Frequently Asked Questions</h2>
      </div>

      <div class="max-w-2xl mx-auto space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-sm font-medium select-none">
              {faq.question}
              <svg class="w-5 h-5 text-neutral-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed -mt-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Print-only Sheet ── -->
  <div id="print-sheet" class="hidden print:block font-serif text-neutral-900 bg-white p-8">
    <div class="text-center pb-6 border-b-2 border-neutral-300 mb-8">
      <h1 class="text-2xl font-bold uppercase tracking-wide">CGPA Calculation Report</h1>
      <p class="text-sm mt-1">Generated by CGPAHelper.com</p>
    </div>

    <div class="grid grid-cols-2 gap-6 text-sm mb-8">
      <div>
        <p><strong>Date:</strong> <span id="print-date"></span></p>
        <p><strong>Grading System:</strong> <span id="print-system-name"></span></p>
      </div>
      <div class="text-right">
        <p class="text-xl"><strong>Calculated CGPA:</strong> <span id="print-cgpa" class="font-bold"></span></p>
        <p class="text-sm text-neutral-500"><span id="print-credits"></span></p>
      </div>
    </div>

    <table class="w-full text-left border-collapse text-sm mb-8">
      <thead>
        <tr class="border-b-2 border-neutral-300 font-bold">
          <th class="py-2">Semester</th>
          <th class="py-2 text-right">GPA</th>
          <th class="py-2 text-right">Credits</th>
        </tr>
      </thead>
      <tbody id="print-table-body">
      </tbody>
    </table>

    <div class="border-t border-neutral-300 pt-6 mt-12 text-xs text-neutral-500">
      <p>Disclaimer: This report represents a mathematical CGPA calculation. Please verify all semester values with your official university transcripts.</p>
    </div>
  </div>
</Layout>

<style>
  /* Print styling rules */
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    .container-page, footer, nav, header, aside, section, .print\:hidden {
      display: none !important;
    }
    #print-sheet {
      display: block !important;
    }
  }
</style>

<script>
  import { gradingSystems, getGradeClassification } from '../data/grading-systems.js';

  // ── DOM References ──
  const systemSelect = document.getElementById('grading-system-select') as HTMLSelectElement;
  const rowsContainer = document.getElementById('semester-rows')!;
  const addBtn = document.getElementById('add-semester-btn')!;
  const resultSection = document.getElementById('result-section') as HTMLElement;
  const resultGpa = document.getElementById('result-gpa')!;
  const resultScale = document.getElementById('result-scale')!;
  const resultLabel = document.getElementById('result-label')!;
  const resultCredits = document.getElementById('result-credits')!;
  const resultContent = document.getElementById('result-content')!;
  const gaugeRing = document.getElementById('gauge-ring') as HTMLDivElement;
  const gaugePercentText = document.getElementById('gauge-percent-text')!;
  const gradingTableTitle = document.getElementById('grading-table-title')!;
  const gradingTableBody = document.getElementById('grading-table-body')!;
  const printPdfBtn = document.getElementById('print-pdf-btn') as HTMLButtonElement;
  const printDate = document.getElementById('print-date')!;
  const printSystemName = document.getElementById('print-system-name')!;
  const printCGPA = document.getElementById('print-cgpa')!;
  const printCredits = document.getElementById('print-credits')!;
  const printTableBody = document.getElementById('print-table-body')!;
  let semesterCount = 0;

  // ── Debounce utility (INP optimization) ──
  function debounce<T extends (...args: any[]) => void>(fn: T, delay: number): T {
    let timer: ReturnType<typeof setTimeout>;
    return ((...args: any[]) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    }) as unknown as T;
  }

  // Debounced save — avoids synchronous localStorage writes on every keystroke
  const debouncedSave = debounce(saveToLocalStorage, 300);

  // ── Helpers ──
  function getCurrentSystem() {
    return gradingSystems[systemSelect.value];
  }

  function createSemesterRow(name: string): HTMLElement {
    semesterCount++;
    const id = semesterCount;
    const maxGPA = getCurrentSystem().maxGPA;

    const row = document.createElement('div');
    row.className = 'grid grid-cols-6 sm:grid-cols-[1fr_140px_140px_40px] gap-3 items-end bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800/40 sm:border-0 rounded-lg p-3 sm:p-2 sm:bg-transparent dark:sm:bg-transparent sm:rounded-none';
    row.setAttribute('role', 'listitem');
    row.dataset.semesterId = String(id);

    row.innerHTML = `
      <div class="col-span-5 sm:col-span-1 min-w-0">
        <label class="sm:hidden font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1 block">Semester</label>
        <input
          type="text"
          value="${name}"
          aria-label="Semester name"
          class="semester-name w-full bg-transparent border-b border-neutral-200 dark:border-neutral-700 focus:border-indigo-500 outline-none text-sm py-1.5 transition-colors placeholder:text-neutral-300 dark:placeholder:text-neutral-600"
          placeholder="Semester name"
        />
      </div>
      <div class="col-span-1 flex justify-center sm:hidden">
        <button
          type="button"
          aria-label="Remove semester"
          class="remove-btn w-8 h-8 flex items-center justify-center text-neutral-400 hover:text-red-500 dark:hover:text-red-400 transition-colors rounded-md hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="col-span-3 sm:col-span-1 min-w-0">
        <label class="sm:hidden font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1 block">GPA</label>
        <input
          type="number"
          step="0.01"
          min="0"
          max="${maxGPA}"
          aria-label="GPA value"
          class="semester-gpa w-full bg-transparent border-b border-neutral-200 dark:border-neutral-700 focus:border-indigo-500 outline-none text-sm py-1.5 transition-colors tabular-nums placeholder:text-neutral-300 dark:placeholder:text-neutral-600"
          placeholder="0.00"
        />
      </div>
      <div class="col-span-3 sm:col-span-1 min-w-0">
        <label class="sm:hidden font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-1 block">Credits</label>
        <input
          type="number"
          min="1"
          step="1"
          aria-label="Credit hours"
          class="semester-credits w-full bg-transparent border-b border-neutral-200 dark:border-neutral-700 focus:border-indigo-500 outline-none text-sm py-1.5 transition-colors tabular-nums placeholder:text-neutral-300 dark:placeholder:text-neutral-600"
          placeholder="0"
        />
      </div>
      <div class="hidden sm:flex sm:justify-center">
        <button
          type="button"
          aria-label="Remove semester"
          class="remove-btn w-8 h-8 flex items-center justify-center text-neutral-400 hover:text-red-500 dark:hover:text-red-400 transition-colors rounded-md hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    `;

    // Event listeners
    const nameInput = row.querySelector('.semester-name') as HTMLInputElement;
    const gpaInput = row.querySelector('.semester-gpa') as HTMLInputElement;
    const creditsInput = row.querySelector('.semester-credits') as HTMLInputElement;
    const removeBtns = row.querySelectorAll('.remove-btn');

    nameInput.addEventListener('input', calculate);
    gpaInput.addEventListener('input', calculate);
    creditsInput.addEventListener('input', calculate);
    removeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        row.remove();
        // Ensure at least 1 row remains
        if (rowsContainer.children.length === 0) {
          addSemester();
        }
        calculate();
      });
    });

    return row;
  }

  function addSemester() {
    const count = rowsContainer.children.length + 1;
    const row = createSemesterRow(`Semester ${count}`);
    rowsContainer.appendChild(row);
  }

  // ── LocalStorage ──
  function saveToLocalStorage() {
    const rows = rowsContainer.querySelectorAll('[role="listitem"]');
    const semestersData = Array.from(rows).map((row) => {
      const nameVal = (row.querySelector('.semester-name') as HTMLInputElement).value;
      const gpaVal = (row.querySelector('.semester-gpa') as HTMLInputElement).value;
      const creditsVal = (row.querySelector('.semester-credits') as HTMLInputElement).value;
      return { name: nameVal, gpa: gpaVal, credits: creditsVal };
    });
    localStorage.setItem('cgpa-helper-calculator-semesters', JSON.stringify({
      system: systemSelect.value,
      semesters: semestersData
    }));
  }

  function loadFromLocalStorage() {
    try {
      const stored = localStorage.getItem('cgpa-helper-calculator-semesters');
      if (stored) {
        const { system, semesters } = JSON.parse(stored);
        if (system && gradingSystems[system]) {
          systemSelect.value = system;
        }
        if (Array.isArray(semesters) && semesters.length > 0) {
          rowsContainer.innerHTML = '';
          semesters.forEach((sem) => {
            const row = createSemesterRow(sem.name);
            rowsContainer.appendChild(row);
            const gpaInput = row.querySelector('.semester-gpa') as HTMLInputElement;
            const creditsInput = row.querySelector('.semester-credits') as HTMLInputElement;
            gpaInput.value = sem.gpa || '';
            creditsInput.value = sem.credits || '';
          });
          return true;
        }
      }
    } catch (e) {
      console.error('Error loading from localStorage:', e);
    }
    return false;
  }

  // ── Calculation ──
  function calculate() {
    const rows = rowsContainer.querySelectorAll('[role="listitem"]');
    let totalWeighted = 0;
    let totalCredits = 0;
    const maxGPA = getCurrentSystem().maxGPA;

    rows.forEach((row) => {
      const gpaInput = row.querySelector('.semester-gpa') as HTMLInputElement;
      const creditsInput = row.querySelector('.semester-credits') as HTMLInputElement;
      const gpa = parseFloat(gpaInput.value);
      const credits = parseFloat(creditsInput.value);

      if (!isNaN(gpa) && !isNaN(credits) && credits > 0 && gpa >= 0 && gpa <= maxGPA) {
        totalWeighted += gpa * credits;
        totalCredits += credits;
      }
    });

    debouncedSave();

    if (totalCredits === 0) {
      resultSection.style.display = 'none';
      return;
    }

    const cgpa = totalWeighted / totalCredits;
    const roundedCGPA = Math.round(cgpa * 100) / 100;
    const classification = getGradeClassification(roundedCGPA, maxGPA);

    // Show result
    resultSection.style.display = '';

    // Update GPA text
    resultGpa.textContent = roundedCGPA.toFixed(2);
    resultScale.textContent = `/ ${maxGPA}`;

    // Update classification label
    resultLabel.textContent = classification.label;
    resultLabel.className = `inline-block text-sm font-medium px-2.5 py-0.5 rounded-full ${classification.bg} ${classification.color}`;

    // Update credits display
    resultCredits.textContent = `${totalCredits} credit${totalCredits !== 1 ? 's' : ''} total`;

    // Update linear progress bar
    const ratio = roundedCGPA / maxGPA;
    requestAnimationFrame(() => {
      gaugeRing.style.width = `${ratio * 100}%`;
      gaugeRing.style.backgroundColor = classification.ring;
      gaugePercentText.textContent = `${Math.round(ratio * 100)}%`;
    });

    // Pop animation
    resultContent.classList.remove('result-pop');
    // Force reflow
    void resultContent.offsetWidth;
    resultContent.classList.add('result-pop');
  }

  // ── Grading table ──
  function updateGradingTable() {
    const system = getCurrentSystem();
    gradingTableTitle.textContent = system.shortName;

    gradingTableBody.innerHTML = system.grades
      .map(
        (g: { letter: string; point: number; range: string }) => `
      <tr class="border-b border-neutral-100 dark:border-neutral-800/50 last:border-0">
        <td class="py-2 pr-4 font-mono font-medium">${g.letter}</td>
        <td class="py-2 pr-4 tabular-nums text-neutral-600 dark:text-neutral-400">${g.point.toFixed(g.point % 1 === 0 ? 0 : 2)}</td>
        <td class="py-2 text-neutral-500 dark:text-neutral-500">${g.range}%</td>
      </tr>
    `
      )
      .join('');
  }

  // ── Update max GPA on all inputs ──
  function updateMaxGPAValidation() {
    const maxGPA = getCurrentSystem().maxGPA;
    const inputs = rowsContainer.querySelectorAll('.semester-gpa') as NodeListOf<HTMLInputElement>;
    inputs.forEach((input) => {
      input.max = String(maxGPA);
      // Clamp existing values
      const val = parseFloat(input.value);
      if (!isNaN(val) && val > maxGPA) {
        input.value = String(maxGPA);
      }
    });
  }

  // ── System change handler ──
  systemSelect.addEventListener('change', () => {
    updateMaxGPAValidation();
    updateGradingTable();
    calculate();
  });

  // ── Add semester button ──
  addBtn.addEventListener('click', () => {
    addSemester();
  });

  // ── Print Report Preparation ──
  function preparePrintSheet() {
    printDate.textContent = new Date().toLocaleDateString(undefined, { dateStyle: 'long' });
    printSystemName.textContent = getCurrentSystem().name;
    printCGPA.textContent = `${resultGpa.textContent} / ${getCurrentSystem().maxGPA}`;
    printCredits.textContent = resultCredits.textContent;

    const rows = rowsContainer.querySelectorAll('[role="listitem"]');
    printTableBody.innerHTML = '';
    rows.forEach((row) => {
      const nameVal = (row.querySelector('.semester-name') as HTMLInputElement).value;
      const gpaVal = (row.querySelector('.semester-gpa') as HTMLInputElement).value;
      const creditsVal = (row.querySelector('.semester-credits') as HTMLInputElement).value;

      if (gpaVal || creditsVal) {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-neutral-200';
        tr.innerHTML = `
          <td class="py-2.5">${nameVal || '—'}</td>
          <td class="py-2.5 text-right font-mono">${gpaVal || '0.00'}</td>
          <td class="py-2.5 text-right font-mono">${creditsVal || '0'}</td>
        `;
        printTableBody.appendChild(tr);
      }
    });
  }

  printPdfBtn.addEventListener('click', () => {
    preparePrintSheet();
    window.print();
  });

  // ── Initialize ──
  const loaded = loadFromLocalStorage();
  if (!loaded) {
    rowsContainer.appendChild(createSemesterRow('Semester 1'));
    rowsContainer.appendChild(createSemesterRow('Semester 2'));
  }
  updateGradingTable();
  calculate();
</script>
