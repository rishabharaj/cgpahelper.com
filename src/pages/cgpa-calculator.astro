  const pctResultValueFromPct = document.getElementById('pct-result-value-from-pct')!;
  const pctResultScaleFromPct = document.getElementById('pct-result-scale-from-pct')!;
  const pctResultLabelFromPct = document.getElementById('pct-result-label-from-pct')!;
  
  const pctGaugeCircle = document.getElementById('pct-gauge-circle') as SVGCircleElement;
  const pctGaugeText = document.getElementById('pct-gauge-percent-text')!;
  const pctStepsContent = document.getElementById('pct-steps-content')!;

  const pctRefHeaderInput = document.getElementById('pct-ref-header-input')!;
  const pctRefHeaderOutput = document.getElementById('pct-ref-header-output')!;
  const pctRefTableBody = document.getElementById('pct-ref-table-body')!;

  let currentPercentageMode = 'gpa-to-pct';

  function getConversionRule() {
    return conversionRules[pctSystemSelect.value] || conversionRules['us-4-0'];
  }

  function setPercentageMode(mode: 'gpa-to-pct' | 'pct-to-gpa') {
    currentPercentageMode = mode;
    
    if (mode === 'gpa-to-pct') {
      pctModeGpaToPct.className = "flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 shadow-sm";
      pctModePctToGpa.className = "flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer text-neutral-500 hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-100";
      cgpaInputContainer.classList.remove('hidden');
      pctInputContainer.classList.add('hidden');
      cgpaInputField.focus();
    } else {
      pctModePctToGpa.className = "flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 shadow-sm";
      pctModeGpaToPct.className = "flex-1 text-center py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer text-neutral-500 hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-100";
      pctInputContainer.classList.remove('hidden');
      cgpaInputContainer.classList.add('hidden');
      pctInputField.focus();
    }

    updatePctFormulaPreview();
    updatePctRefTable();
    calculatePercentage();

    const url = new URL(window.location.href);
    if (url.searchParams.get('tab') === 'percentage') {
      url.searchParams.set('mode', mode === 'gpa-to-pct' ? 'to-percentage' : 'from-percentage');
      window.history.replaceState(null, '', url.toString());
    }
  }

  pctModeGpaToPct.addEventListener('click', () => setPercentageMode('gpa-to-pct'));
  pctModePctToGpa.addEventListener('click', () => setPercentageMode('pct-to-gpa'));

  function updatePctFormulaPreview() {
    const rule = getConversionRule();
    if (currentPercentageMode === 'gpa-to-pct') {
      pctFormulaDisplay.textContent = rule.formula;
    } else {
      pctFormulaDisplay.textContent = rule.reverseFormula;
    }
    pctFormulaNote.textContent = rule.note;
  }

  function calculatePercentage() {
    const rule = getConversionRule();
    const max = rule.maxGPA;
    
    if (currentPercentageMode === 'gpa-to-pct') {
      const cgpa = parseFloat(cgpaInputField.value);
      if (isNaN(cgpa) || cgpa < 0 || cgpa > max) {
        pctResultPanelEmpty.classList.remove('hidden');
        pctResultPanelState.classList.add('hidden');
        if (!isNaN(cgpa)) {
          document.getElementById('cgpa-input-error')?.classList.remove('hidden');
        }
        return;
      }
      document.getElementById('cgpa-input-error')?.classList.add('hidden');
      
      let pct = 0;
      let stepStr = '';
      if (rule.type === 'multiply') {
        pct = cgpa * rule.factor;
        stepStr = `1. Multiply CGPA by conversion factor: ${cgpa.toFixed(2)} × ${rule.factor}<br>2. Result = <strong>${pct.toFixed(2)}%</strong>`;
      } else if (rule.type === 'linear') {
        pct = rule.a * cgpa + rule.b;
        stepStr = `1. Multiply CGPA by coefficient: ${rule.a} × ${cgpa.toFixed(2)} = ${(rule.a * cgpa).toFixed(2)}<br>2. Add offset: ${(rule.a * cgpa).toFixed(2)} + ${rule.b}<br>3. Result = <strong>${pct.toFixed(2)}%</strong>`;
      }
      pct = Math.min(100, Math.max(0, pct));
      const classification = getGradeClassification(cgpa, max);

      pctResultPanelEmpty.classList.add('hidden');
      pctResultPanelState.classList.remove('hidden');
      pctResultUiToPct.classList.remove('hidden');
      pctResultUiFromPct.classList.add('hidden');

      pctResultValueToPct.textContent = pct.toFixed(2);
      pctResultLabelToPct.textContent = classification.label;
      pctResultLabelToPct.className = `mt-2 text-xs font-semibold px-2.5 py-0.5 rounded-full inline-block ${classification.bg} ${classification.color}`;
      pctStepsContent.innerHTML = stepStr;

    } else {
      const pct = parseFloat(pctInputField.value);
      if (isNaN(pct) || pct < 0 || pct > 100) {
        pctResultPanelEmpty.classList.remove('hidden');
        pctResultPanelState.classList.add('hidden');
        if (!isNaN(pct)) {
          document.getElementById('pct-input-error')?.classList.remove('hidden');
        }
        return;
      }
      document.getElementById('pct-input-error')?.classList.add('hidden');

      let cgpa = 0;
      let stepStr = '';
      if (rule.type === 'multiply') {
        cgpa = pct / rule.factor;
        stepStr = `1. Divide percentage by conversion factor: ${pct.toFixed(2)}% ÷ ${rule.factor}<br>2. Result = <strong>${cgpa.toFixed(2)}</strong> out of ${max}`;
      } else if (rule.type === 'linear') {
        cgpa = (pct - rule.b) / rule.a;
        stepStr = `1. Subtract offset from percentage: ${pct.toFixed(2)}% - ${rule.b} = ${(pct - rule.b).toFixed(2)}<br>2. Divide by coefficient: ${(pct - rule.b).toFixed(2)} ÷ ${rule.a}<br>3. Result = <strong>${cgpa.toFixed(2)}</strong> out of ${max}`;
      }
      cgpa = Math.min(max, Math.max(0, cgpa));
      const classification = getGradeClassification(cgpa, max);

      pctResultPanelEmpty.classList.add('hidden');
      pctResultPanelState.classList.remove('hidden');
      pctResultUiToPct.classList.add('hidden');
      pctResultUiFromPct.classList.remove('hidden');

      pctResultValueFromPct.textContent = cgpa.toFixed(2);
      pctResultScaleFromPct.textContent = `/ ${max.toFixed(2)}`;
      pctResultLabelFromPct.textContent = classification.label;
      pctResultLabelFromPct.className = `inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${classification.bg} ${classification.color}`;

      pctStepsContent.innerHTML = stepStr;

      const ratio = cgpa / max;
      const offset = 251.33 - (251.33 * ratio);
      pctGaugeCircle.style.strokeDashoffset = String(offset);
      pctGaugeCircle.style.stroke = classification.ring;
      pctGaugeText.textContent = `${Math.round(ratio * 100)}%`;
      pctGaugeText.style.color = classification.ring;
    }
  }

  function updatePctRefTable() {
    const rule = getConversionRule();
    const max = rule.maxGPA;

    if (currentPercentageMode === 'gpa-to-pct') {
      pctRefHeaderInput.textContent = 'CGPA';
      pctRefHeaderOutput.textContent = 'Percentage';
      
      const cgpaSteps = [max, max * 0.9, max * 0.8, max * 0.75, max * 0.6, max * 0.5, max * 0.4];
      pctRefTableBody.innerHTML = cgpaSteps.map(cgpa => {
        let pct = 0;
        if (rule.type === 'multiply') pct = cgpa * rule.factor;
        else if (rule.type === 'linear') pct = rule.a * cgpa + rule.b;
        pct = Math.min(100, Math.max(0, pct));
        const classification = getGradeClassification(cgpa, max);
        return `
          <tr class="border-b border-neutral-100 dark:border-neutral-800/50 last:border-0 hover:bg-neutral-50/50 dark:hover:bg-neutral-900/30 transition-colors">
            <td class="px-6 py-3 font-mono font-medium text-neutral-800 dark:text-neutral-200">${cgpa.toFixed(2)}</td>
            <td class="px-6 py-3 font-mono text-neutral-600 dark:text-neutral-400">${pct.toFixed(2)}%</td>
            <td class="px-6 py-3 hidden sm:table-cell">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${classification.bg} ${classification.color}">${classification.label}</span>
            </td>
          </tr>
        `;
      }).join('');
    } else {
      pctRefHeaderInput.textContent = 'Percentage';
      pctRefHeaderOutput.textContent = 'CGPA Equivalent';
      
      const pctSteps = [95, 90, 85, 80, 75, 70, 60, 50, 40];
      pctRefTableBody.innerHTML = pctSteps.map(pct => {
        let cgpa = 0;
        if (rule.type === 'multiply') cgpa = pct / rule.factor;
        else if (rule.type === 'linear') cgpa = (pct - rule.b) / rule.a;
        cgpa = Math.min(max, Math.max(0, cgpa));
        const classification = getGradeClassification(cgpa, max);
        return `
          <tr class="border-b border-neutral-100 dark:border-neutral-800/50 last:border-0 hover:bg-neutral-50/50 dark:hover:bg-neutral-900/30 transition-colors">
            <td class="px-6 py-3 font-mono font-medium text-neutral-800 dark:text-neutral-200">${pct}%</td>
            <td class="px-6 py-3 font-mono text-neutral-600 dark:text-neutral-400">${cgpa.toFixed(2)} / ${max.toFixed(2)}</td>
            <td class="px-6 py-3 hidden sm:table-cell">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${classification.bg} ${classification.color}">${classification.label}</span>
            </td>
          </tr>
        `;
      }).join('');
    }
  }

  cgpaInputField.addEventListener('input', calculatePercentage);
  pctInputField.addEventListener('input', calculatePercentage);
  pctSystemSelect.addEventListener('change', () => {
    const rule = getConversionRule();
    cgpaInputField.max = String(rule.maxGPA);
    if (parseFloat(cgpaInputField.value) > rule.maxGPA) {
      cgpaInputField.value = String(rule.maxGPA);
    }
    updatePctFormulaPreview();
    updatePctRefTable();
    calculatePercentage();
  });

  document.querySelectorAll('.quick-pick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-quick');
      if (val) {
        pctInputField.value = val;
        calculatePercentage();
      }
    });
  });


  // ── PDF EXPORT MODULE (SHARED) ──
  function preparePrintSheet(activeTab: string) {
    const dateSpans = document.querySelectorAll('.print-date');
    const systemSpans = document.querySelectorAll('.print-system-name');
    const gpaSpans = document.querySelectorAll('.print-gpa');
    const creditSpans = document.querySelectorAll('.print-credits');
    const tableBodies = document.querySelectorAll('.print-table-body');

    const dateVal = new Date().toLocaleDateString(undefined, { dateStyle: 'long' });
    dateSpans.forEach(span => span.textContent = dateVal);

    if (activeTab === 'sgpa') {
      const sysName = getSharedSystem().name;
      systemSpans.forEach(span => span.textContent = sysName);
      gpaSpans.forEach(span => span.textContent = `${sgpaResultGpa.textContent} ${sgpaResultScale.textContent}`);
      creditSpans.forEach(span => span.textContent = `${sgpaResultCredits.textContent} credits total`);

      const rows = sgpaContainer.querySelectorAll('.course-row');
      tableBodies.forEach(tbody => {
        tbody.innerHTML = Array.from(rows).map(row => {
          const name = (row.querySelector('.course-name') as HTMLInputElement).value;
          const credits = (row.querySelector('.course-credits') as HTMLInputElement).value;
          const gradeSelect = row.querySelector('.course-grade') as HTMLSelectElement;
          const gradeText = gradeSelect.options[gradeSelect.selectedIndex]?.text || '';
          return `
            <tr class="border-b border-neutral-200">
              <td class="py-2.5">${name || '—'}</td>
              <td class="py-2.5 text-right font-mono">${credits || '0'}</td>
              <td class="py-2.5 text-center font-mono font-medium">${gradeText || '—'}</td>
            </tr>
          `;
        }).join('');
      });

    } else if (activeTab === 'cgpa') {
      const sysName = getSharedSystem().name;
      systemSpans.forEach(span => span.textContent = sysName);
      gpaSpans.forEach(span => span.textContent = `${cgpaResultGpa.textContent} ${cgpaResultScale.textContent}`);
      creditSpans.forEach(span => span.textContent = cgpaResultCredits.textContent);

      const rows = cgpaContainer.querySelectorAll('[role="listitem"]');
      tableBodies.forEach(tbody => {
        tbody.innerHTML = Array.from(rows).map(row => {
          const name = (row.querySelector('.semester-name') as HTMLInputElement).value;
          const gpa = (row.querySelector('.semester-gpa') as HTMLInputElement).value;
          const credits = (row.querySelector('.semester-credits') as HTMLInputElement).value;
          return `
            <tr class="border-b border-neutral-200">
              <td class="py-2.5">${name || '—'}</td>
              <td class="py-2.5 text-right font-mono">${gpa || '0.00'}</td>
              <td class="py-2.5 text-right font-mono">${credits || '0'}</td>
            </tr>
          `;
        }).join('');
      });
    }
  }

  async function downloadPDF(activeTab: string, btnElement: HTMLButtonElement) {
    const originalText = btnElement.innerHTML;
    btnElement.disabled = true;
    btnElement.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-neutral-500 inline-block" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Generating PDF...
    `;

    try {
      const { jsPDF } = await import('jspdf');
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageWidth = doc.internal.pageSize.getWidth();
      const margin = 20;
      let y = 25;

      // ── Header ──
      doc.setFontSize(20);
      doc.setFont('helvetica', 'bold');
      const headerText = activeTab === 'sgpa' ? 'SGPA Calculation Report' : 'CGPA Calculation Report';
      doc.text(headerText, pageWidth / 2, y, { align: 'center' });
      y += 8;

      doc.setFontSize(10);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(120);
      doc.text('Generated by CGPAHelper.com', pageWidth / 2, y, { align: 'center' });
      y += 4;

      // Divider line
      doc.setDrawColor(200);
      doc.setLineWidth(0.5);
      doc.line(margin, y, pageWidth - margin, y);
      y += 10;

      // ── Meta info ──
      doc.setTextColor(60);
      doc.setFontSize(11);
      const dateVal = new Date().toLocaleDateString(undefined, { dateStyle: 'long' });
      const sysName = getSharedSystem().name;

      doc.setFont('helvetica', 'bold');
      doc.text('Date:', margin, y);
      doc.setFont('helvetica', 'normal');
      doc.text(dateVal, margin + 18, y);
      y += 7;

      doc.setFont('helvetica', 'bold');
      doc.text('Grading System:', margin, y);
      doc.setFont('helvetica', 'normal');
      doc.text(sysName, margin + 42, y);
      y += 12;

      if (activeTab === 'sgpa') {
        // ── SGPA Result Summary ──
        const gpaVal = sgpaResultGpa.textContent || '0.00';
        const scaleVal = sgpaResultScale.textContent || '';
        const creditsVal = sgpaResultCredits.textContent || '0';
        const pointsVal = sgpaResultPoints.textContent || '0.00';

        doc.setFontSize(14);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(30);
        doc.text(`Calculated SGPA: ${gpaVal} ${scaleVal}`, margin, y);
        y += 8;

        doc.setFontSize(10);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(100);
        doc.text(`Total Credits: ${creditsVal}  |  Total Grade Points: ${pointsVal}`, margin, y);
        y += 14;

        // ── Courses Table ──
        const colWidths = [85, 30, 55];
        const headers = ['Course Name', 'Credits', 'Grade'];
        const startX = margin;

        // Table header
        doc.setFillColor(245, 245, 245);
        doc.rect(startX, y - 5, colWidths[0] + colWidths[1] + colWidths[2], 8, 'F');
        doc.setFontSize(9);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(80);
        let x = startX + 3;
        headers.forEach((h, i) => {
          doc.text(h, x, y);
          x += colWidths[i];
        });
        y += 6;

        // Divider
        doc.setDrawColor(220);
        doc.setLineWidth(0.3);
        doc.line(startX, y, startX + colWidths[0] + colWidths[1] + colWidths[2], y);
        y += 5;

        // Table rows
        const rows = sgpaContainer.querySelectorAll('.course-row');
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(50);
        doc.setFontSize(10);
        rows.forEach(row => {
          const name = (row.querySelector('.course-name') as HTMLInputElement).value || '—';
          const credits = (row.querySelector('.course-credits') as HTMLInputElement).value || '0';
          const gradeSelect = row.querySelector('.course-grade') as HTMLSelectElement;
          const gradeText = gradeSelect.options[gradeSelect.selectedIndex]?.text || '—';

          x = startX + 3;
          doc.text(name.substring(0, 35), x, y);
          x += colWidths[0];
          doc.text(credits, x, y);
          x += colWidths[1];
          doc.text(gradeText, x, y);
          y += 7;

          if (y > 270) {
            doc.addPage();
            y = 25;
          }
        });

      } else if (activeTab === 'cgpa') {
        // ── CGPA Result Summary ──
        const gpaVal = cgpaResultGpa.textContent || '0.00';
        const scaleVal = cgpaResultScale.textContent || '';
        const creditsText = cgpaResultCredits.textContent || '';

        doc.setFontSize(14);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(30);
        doc.text(`Calculated CGPA: ${gpaVal} ${scaleVal}`, margin, y);
        y += 8;

        doc.setFontSize(10);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(100);
        doc.text(creditsText, margin, y);
        y += 14;

        // ── Semesters Table ──
        const colWidths = [85, 40, 40];
        const headers = ['Semester', 'GPA', 'Credits'];
        const startX = margin;

        // Table header
        doc.setFillColor(245, 245, 245);
        doc.rect(startX, y - 5, colWidths[0] + colWidths[1] + colWidths[2], 8, 'F');
        doc.setFontSize(9);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(80);
        let x = startX + 3;
        headers.forEach((h, i) => {
          doc.text(h, x, y);
          x += colWidths[i];
        });
        y += 6;

        doc.setDrawColor(220);
        doc.setLineWidth(0.3);
        doc.line(startX, y, startX + colWidths[0] + colWidths[1] + colWidths[2], y);
        y += 5;

        // Table rows
        const rows = cgpaContainer.querySelectorAll('[role="listitem"]');
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(50);
        doc.setFontSize(10);
        rows.forEach(row => {
          const name = (row.querySelector('.semester-name') as HTMLInputElement).value || '—';
          const gpa = (row.querySelector('.semester-gpa') as HTMLInputElement).value || '0.00';
          const credits = (row.querySelector('.semester-credits') as HTMLInputElement).value || '0';

          x = startX + 3;
          doc.text(name.substring(0, 35), x, y);
          x += colWidths[0];
          doc.text(gpa, x, y);
          x += colWidths[1];
          doc.text(credits, x, y);
          y += 7;

          if (y > 270) {
            doc.addPage();
            y = 25;
          }
        });
      }

      // ── Footer ──
      y += 10;
      if (y > 260) {
        doc.addPage();
        y = 25;
      }
      doc.setDrawColor(200);
      doc.setLineWidth(0.3);
      doc.line(margin, y, pageWidth - margin, y);
      y += 6;
      doc.setFontSize(8);
      doc.setTextColor(150);
      doc.text('Disclaimer: This report represents a mathematical calculation. Please verify all values with your official transcripts.', margin, y);
      y += 5;
      doc.text(`Generated on ${dateVal} by CGPAHelper.com`, margin, y);

      const filename = activeTab === 'sgpa' ? 'SGPA-Report.pdf' : 'CGPA-Report.pdf';
      doc.save(filename);
    } catch (err) {
      console.error('PDF generation failed:', err);
      alert('Failed to generate PDF. Please try again.');
    } finally {
      btnElement.disabled = false;
      btnElement.innerHTML = originalText;
    }
  }

  sgpaPrintBtn.addEventListener('click', () => {
    downloadPDF('sgpa', sgpaPrintBtn);
  });

  cgpaPrintBtn.addEventListener('click', () => {
    downloadPDF('cgpa', cgpaPrintBtn);
  });


  // ── APP INITIALIZATION ──
  function initAllCalculators() {
    // 1. SGPA Init
    const sgpaLoaded = loadSgpaFromLocalStorage();
    if (!sgpaLoaded) {
      for (let i = 1; i <= 3; i++) {
        sgpaContainer.appendChild(createSgpaCourseRow(`Course ${i}`));
      }
    }
    calculateSgpa();

    // 2. CGPA Init
    const cgpaLoaded = loadCgpaFromLocalStorage();
    if (!cgpaLoaded) {
      cgpaContainer.appendChild(createCgpaSemesterRow('Semester 1'));
      cgpaContainer.appendChild(createCgpaSemesterRow('Semester 2'));
    }
    calculateCgpa();

    // 3. Percentage Converter Init
    pctSystemSelect.value = 'cbse-ugc-india';
    pctSystemSelect.dispatchEvent(new Event('change'));
    setPercentageMode('gpa-to-pct');

    // 4. Shared elements default load
    updateSharedGradingTable();

    // 5. URL Tab Handler
    initTabFromUrl();
  }

  // Run initial setup directly (since script is deferred / module type)
  initAllCalculators();
</script>
