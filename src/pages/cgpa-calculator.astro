    let totalWeighted = 0;
    let totalCredits = 0;
    const max = sys.maxGPA;

    rows.forEach(row => {
      const gpa = parseFloat((row.querySelector('.semester-gpa') as HTMLInputElement).value);
      const credits = parseFloat((row.querySelector('.semester-credits') as HTMLInputElement).value);

      if (!isNaN(gpa) && !isNaN(credits) && credits > 0 && gpa >= 0 && gpa <= max) {
        totalWeighted += gpa * credits;
        totalCredits += credits;
      }
