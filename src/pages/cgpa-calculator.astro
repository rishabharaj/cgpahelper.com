  function rebuildSgpaGradeDropdowns() {
    const opts = buildSgpaGradeOptions();
    sgpaContainer.querySelectorAll('.course-grade').forEach(sel => {
      const curr = (sel as HTMLSelectElement).value;
      (sel as HTMLSelectElement).innerHTML = opts;
      const matching = (sel as HTMLSelectElement).querySelector(`option[value="${curr}"]`);
      if (matching) (sel as HTMLSelectElement).value = curr;
    });
  }

  function calculateSgpa() {
    const rows = sgpaContainer.querySelectorAll('.course-row');
    const sys = getSharedSystem();
    if (!sys || rows.length === 0) {
      sgpaResultSection.style.display = 'none';
      return;
    }

    let totalCredits = 0;
    let totalGradePoints = 0;
    let hasValidRow = false;

    rows.forEach(row => {
      const credits = parseFloat((row.querySelector('.course-credits') as HTMLInputElement).value) || 0;
      const grade = parseFloat((row.querySelector('.course-grade') as HTMLSelectElement).value);

      if (credits > 0 && !isNaN(grade)) {
        totalCredits += credits;
        totalGradePoints += credits * grade;
        hasValidRow = true;
      }
    });

    debouncedSaveSgpa();

    if (!hasValidRow || totalCredits === 0) {
      sgpaResultSection.style.display = 'none';
      return;
    }

    const sgpa = totalGradePoints / totalCredits;
    const maxGPA = sys.maxGPA;
    const classification = getGradeClassification(sgpa, maxGPA);

    sgpaResultSection.style.display = 'flex';
    sgpaResultGpa.textContent = sgpa.toFixed(2);
    sgpaResultScale.textContent = `/ ${maxGPA.toFixed(2)}`;
    sgpaResultCredits.textContent = String(totalCredits);
    sgpaResultPoints.textContent = totalGradePoints.toFixed(2);

    sgpaResultClass.textContent = classification.label;
    sgpaResultClass.className = `inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full ${classification.bg} ${classification.color}`;

    const ratio = Math.min(sgpa / maxGPA, 1);
    requestAnimationFrame(() => {
      sgpaGaugeRing.style.width = `${ratio * 100}%`;
      sgpaGaugeRing.style.backgroundColor = classification.ring;
      sgpaGaugeText.textContent = `${Math.round(ratio * 100)}%`;
    });

    sgpaResultContent.classList.remove('result-pop');
    void (sgpaResultGpa as HTMLElement).offsetWidth;
    sgpaResultContent.classList.add('result-pop');
  }

